// A `ref struct` cannot be captured by a lambda: the lambda's closure environment is a
// heap-allocated `CaptureCell<T>`, which would force the captured stack-only value onto the heap.

import system;
ref struct Pair {
    public a: int;
    public b: int;

    public constructor(a: int, b: int) {
        this.a = a;
        this.b = b;
    }
}

fun main(): void {
    let p = Pair(1, 2);
    let f: fun(): int = () => p.a + p.b;
    System.println(f());
}

// A user class opting into `obj[i]` / `obj[i] = v` via `@get_indexer`/`@set_indexer` methods.

import system;
class Grid {
    cells: int[];

    public constructor(size: int) {
        this.cells = Buffer.alloc<int>(size);
    }

    @get_indexer
    public fun get(index: int): int {
        return this.cells[index];
    }

    @set_indexer
    public fun set(index: int, value: int): void {
        this.cells[index] = value;
    }
}

fun main() {
    let g = Grid(4);
    g[0] = 5;
    g[1] = 10;
    g[2] = g[0] + g[1];   // read indexer on both sides
    System.println(g[0]); // 5
    System.println(g[1]); // 10
    System.println(g[2]); // 15
}

// Variadic parameters work on overloaded functions.

import system;
fun h(x: int, ...rest: int[]): int {
    let total = x;
    for (let n in rest) {
        total = total + n;
    }
    return total;
}

fun h(x: string, ...rest: string[]): int {
    return 1;
}

fun main(): void {
    System.println(h(1, 2, 3));
}

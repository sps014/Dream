import system;
import system.text;

fun main(): void {
    let s = "aé🙂";
    System.println(s.size);
    System.println(s.byte_size());
    System.println(s.char_at(0).to_int());
    System.println(s.char_at(1).to_int());
    System.println(s.char_at(2).to_int());
    System.println(s.byte_at(0));
    System.println(s.byte_at(1));
    System.println(s.byte_at(2));
    let i = 0;
    while (i < s.size) {
        System.println(s.char_at(i).to_int());
        i = i + 1;
    }
}

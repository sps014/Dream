// See `linked_list.dream` for why a self-referencing `next` needs `@allow_cycle`.
import system;
@allow_cycle
class Node {
    public value: int;
    public next: Option<Node>;

    public constructor(value: int, next: Option<Node>) {
        this.value = value;
        this.next = next;
    }

    public fun has_next(): bool {
        return this.next.is_some();
    }
}

fun create_list(n: int): Option<Node> {
    if (n <= 0) {
        return Option.None;
    }
    let no_next: Option<Node> = Option.None;
    let head = Node(n, no_next);
    let curr = head;
    let i = n - 1;
    while (i > 0) {
        let nxt = Node(i, no_next);
        curr.next = Option.Some(nxt);
        curr = nxt;
        i = i - 1;
    }
    return Option.Some(head);
}

fun main(): void {
    let list = create_list(3);

    let curr = list;
    let done = false;
    while (!done) {
        switch (curr) {
            Some(n) => {
                System.println(n.value);
                if (n.has_next()) {
                    System.print(" -> ");
                }
                curr = n.next;
            }
            None => {
                done = true;
            }
        }
    }
    System.print("\n");
}

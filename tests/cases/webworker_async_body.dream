// A `WebWorker`/`WebWorker.map`/`WebWorkerPool.dispatch` body *may* be a non-capturing top-level
// `async fun` returning `string`, as long as its return type is `string` (see the constraint in
// `Analyzer::analyze_identifier`): the worker-invoke trampoline (`src/mir/emit/module.rs`) detects
// the async constructor's untagged `Future` result and drives it to completion in place before
// handing back the reply, so `await`ing another async call (or an extern host op like
// `Time.sleep`) inside the body works correctly.
async fun tick(): void {
    await Time.sleep(1);
}

async fun work(msg: string): string {
    await tick();
    return msg + "!";
}

async fun main(): void {
    let w = WebWorker<string, string>(work);
    System.println(await w.send("hi"));
    w.terminate();
}

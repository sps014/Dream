module support.html_dsl;

// Registers `html { ... }` and provides the runtime `Html` helpers the expander emits into.

public class Html {
    public static fun el(tag: string, attrs: string[], inner: string): string {
        let a = "";
        let i = 0;
        while (i + 1 < attrs.length) {
            a = a + " " + attrs[i] + "=\"" + attrs[i + 1] + "\"";
            i = i + 2;
        }
        return "<" + tag + a + ">" + inner + "</" + tag + ">";
    }

    public static fun render(html: string): string {
        return html;
    }
}

@generator
@syntax_block("html")
public fun html(): void {
}

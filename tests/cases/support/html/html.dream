module html;

/// Runtime HTML helpers — emit target for the sample `html { }` Dream compiler.

/// Builds an HTML element string from a tag, alternating attr key/value pairs, and inner HTML.
public class Html {
    public static fun el(tag: string, attrs: string[], inner: string): string {
        let a = "";
        let i = 0;
        while (i + 1 < attrs.length) {
            a = a + " " + attrs[i] + "=\"" + attrs[i + 1] + "\"";
            i = i + 2;
        }
        return "<" + tag + a + ">" + inner + "</" + tag + ">";
    }

    /// Identity helper so nested `el` results compose cleanly.
    public static fun render(html: string): string {
        return html;
    }

    /// Joins mixed string parts (text + splices).
    public static fun text(parts: string[]): string {
        let s = "";
        let i = 0;
        while (i < parts.length) {
            s = s + parts[i];
            i = i + 1;
        }
        return s;
    }
}

// `WebWorker<TIn, TOut>` also supports `T[]` (`T` itself `unmanaged`) for `TIn`/`TOut`: it crosses
// the wire as a dynamic-length raw byte-blit of the array's elements (never the array pointer, so
// the two sides never alias the same heap block), reconstructed as a fresh array on the other side.

struct Point {
    public x: int;
    public y: int;

    constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

fun doubleAll(nums: int[]): int[] {
    let out = Buffer.alloc<int>(nums.size());
    for (let i = 0; i < nums.size(); i = i + 1) {
        out[i] = nums[i] * 2;
    }
    return out;
}

fun shiftAll(points: Point[]): Point[] {
    let out = Buffer.alloc<Point>(points.size());
    for (let i = 0; i < points.size(); i = i + 1) {
        out[i] = Point(points[i].x + 1, points[i].y + 1);
    }
    return out;
}

async fun main(): void {
    let w1 = WebWorker<int[], int[]>(doubleAll);
    let nums = [1, 2, 3, 4, 5];
    let doubled = await w1.send(nums);
    let s1 = "";
    for (let i = 0; i < doubled.size(); i = i + 1) {
        s1 = s1 + doubled[i] + " ";
    }
    System.println(s1.trim());
    w1.terminate();

    let w2 = WebWorker<Point[], Point[]>(shiftAll);
    let pts = [Point(1, 2), Point(3, 4)];
    let shifted = await w2.send(pts);
    let s2 = "";
    for (let i = 0; i < shifted.size(); i = i + 1) {
        s2 = s2 + shifted[i].x + "," + shifted[i].y + " ";
    }
    System.println(s2.trim());
    w2.terminate();
}

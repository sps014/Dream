// Async lambda body with a non-string `TOut` — the Future-body overload awaits then wire-encodes,
// so any unmanaged `TOut` works (the old sync-constructor trampoline path was string-only).
async fun main(): void {
    let w = WebWorker<int, int>(async (n) => {
        await Time.sleep(1);
        return n * 2;
    });
    System.println((await w.send(21)).to_string());
    w.terminate();
}

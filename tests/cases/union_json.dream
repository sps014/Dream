import system;
import system.json;
@json
class Point {
    public x: int;
    public y: int;

    constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

@json
enum Shape {
    Circle(radius: int),
    Rect(width: int, height: int),
    Located(at: Point),
    Empty,
}

fun main(): void {
    let c = Shape.Circle(7);
    System.println(Json.serialize(c));
    System.println(Json.deserialize<Shape>(Json.serialize(c)).unwrap_or(Shape.Empty).to_string());

    let r = Shape.Rect(3, 4);
    System.println(Json.serialize(r));
    System.println(Json.deserialize<Shape>(Json.serialize(r)).unwrap_or(Shape.Empty).to_string());

    let e = Shape.Empty;
    System.println(Json.serialize(e));
    System.println(Json.deserialize<Shape>(Json.serialize(e)).unwrap_or(Shape.Empty).to_string());

    let l = Shape.Located(Point(1, 2));
    System.println(Json.serialize(l));
    System.println(Json.deserialize<Shape>(Json.serialize(l)).unwrap_or(Shape.Empty).to_string());
}

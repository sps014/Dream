// An optional value struct (`Option<Point>`) replaces the old nullable-value-struct feature:
// `Some`/`None` make the "no value" case explicit, and `unwrap_or` (the `??` sugar) hands back an
// inline `Point` either way.

import system;
struct Point {
    public x: int;
    public y: int;
    constructor(x: int, y: int) { this.x = x; this.y = y; }
}

fun show(p: Option<Point>): void {
    if (p.is_none()) {
        System.println("none");
    } else {
        System.println("some");
    }
}

fun main(): void {
    let a: Option<Point> = Option.Some(Point(3, 4));
    let b: Option<Point> = Option.None;
    show(a);
    show(b);

    // Coalesce back to an inline Point, then read its fields.
    let c: Point = a ?? Point(0, 0);
    System.println(c.x);
    System.println(c.y);
    let d: Point = b ?? Point(7, 8);
    System.println(d.x);
    System.println(d.y);
}

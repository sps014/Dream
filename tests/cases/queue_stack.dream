import system;
import system.collections;
fun main(): void {
    let q = Queue<int>();
    q.enqueue(1);
    q.enqueue(2);
    q.enqueue(3);
    System.println(q.dequeue().unwrap_or(0));
    System.println(q.peek().unwrap_or(0));
    System.println(q.length);

    let s = Stack<int>();
    s.push(10);
    s.push(20);
    System.println(s.pop().unwrap_or(0));
    System.println(s.peek().unwrap_or(0));
}

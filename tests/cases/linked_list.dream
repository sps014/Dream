// `next` is a self-reference (`Node` holding a strong `Option<Node>`), so the compiler's
// structural cycle check flags it: it cannot prove this list is never wired into a loop. This
// list is genuinely acyclic, so `@allow_cycle` documents that the author has checked it manually.
import system;
@allow_cycle
class Node {
    public value: int;
    public next: Option<Node>;

    constructor(value: int, next: Option<Node>) {
        this.value = value;
        this.next = next;
    }
}

fun create_node(val: int): Node {
    let no_next: Option<Node> = Option.None;
    let n = Node(val, no_next);
    return n;
}

fun main(): void {
    let head = create_node(10);
    let second = create_node(20);
    let third = create_node(30);
    second.next = Option.Some(third);
    head.next = Option.Some(second);

    let curr: Option<Node> = Option.Some(head);
    let done = false;
    while (!done) {
        switch (curr) {
            Some(n) => {
                System.println(n.value);
                curr = n.next;
            }
            None => {
                done = true;
            }
        }
    }
}

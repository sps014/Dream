import system;
async fun apply_async(f: fun(int): Future<int>, v: int): int {
    return await f(v);
}

async fun main(): void {
    let twice: fun(int): Future<int> = async (x) => {
        await Time.sleep(1);
        return x * 2;
    };
    System.println(await twice(21));
    System.println(await apply_async(async (n) => n + 100, 1));
}

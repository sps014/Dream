// A generic function used as a first-class value can be bound without a fun(...) annotation;
// each later use instantiates from context or call-argument types.

import system;
fun natural_order<T : Comparable<T>>(a: T, b: T): int {
    return a.compare(b);
}

fun main(): void {
    let f = natural_order;
    System.println(f(3, 1));
    let g: fun(int, int): int = f;
    System.println(g(1, 2));
}

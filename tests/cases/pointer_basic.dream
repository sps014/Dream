// `Pointer<T>` - manual alloc/realloc/free via `Buffer.alloc`/`realloc`/`free`, bypassing ARC.

import system;
@unsafe
fun main(): void {
    let p = Pointer<int>.alloc(3);
    p.set(0, 10);
    p.set(1, 20);
    p.set(2, 30);
    System.println(p.len());   // 3
    System.println(p.get(0));  // 10
    System.println(p.get(1));  // 20
    System.println(p.get(2));  // 30

    p.realloc(5);
    System.println(p.len());   // 5
    System.println(p.get(0));  // 10 (preserved)
    System.println(p.get(3));  // 0 (zero-filled tail)

    p.free();
    System.println("done");
}

// `Span<T>` is a bounds-checked, non-owning view over an existing array's elements: no copy, no
// heap allocation of its own (it's a `ref struct`), and its own logical range is enforced
// independently of the backing array's actual size.

fun sum(s: Span<int>): int {
    let total = 0;
    let i = 0;
    while (i < s.len()) {
        total = total + s.get(i);
        i = i + 1;
    }
    return total;
}

fun main(): void {
    let xs = [1, 2, 3, 4, 5];

    let whole = Span<int>.of(xs);
    System.println(whole.len());       // 5
    System.println(sum(whole));        // 15

    let mid = whole.slice(1, 3);       // [2, 3, 4]
    System.println(mid.len());         // 3
    System.println(sum(mid));          // 9

    // Writing through a span mutates the backing array.
    mid.set(0, 20);
    System.println(xs[1]);             // 20

    let copy = mid.to_array();
    System.println(copy.size());       // 3
    System.println(copy[0]);           // 20

    // A slice nested within a slice.
    let inner = mid.slice(1, 2);
    System.println(sum(inner));        // 3 + 4 = 7
}

// `@operator` requires a symbol recognized for the tagged method's arity — `&&` is not overloadable.
import system;
class Flag {
    public value: bool;

    public constructor(value: bool) {
        this.value = value;
    }

    @operator("&&")
    fun and(other: Flag): Flag {
        return Flag(this.value && other.value);
    }
}

fun main() {
    let a = Flag(true);
    System.println(a.value);
}

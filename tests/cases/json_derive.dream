import system;
import system.json;
@json
class Address {
    public city: string;
    public zip: string;

    public constructor(city: string, zip: string) {
        this.city = city;
        this.zip = zip;
    }
}

@json
class User {
    public name: string;
    public age: int;
    public active: bool;
    public address: Address;
    public tags: string[];
    public scores: int[];

    public constructor(name: string, age: int, active: bool, address: Address, tags: string[], scores: int[]) {
        this.name = name;
        this.age = age;
        this.active = active;
        this.address = address;
        this.tags = tags;
        this.scores = scores;
    }
}

fun main(): void {
    let u = User("Ada", 36, true, Address("London", "NW1"), ["dev", "math"], [10, 20, 30]);

    let text = Json.serialize(u);
    System.println(text);

    let back = Json.deserialize<User>(text).unwrap_or(u);
    System.println(back.name);
    System.println(back.age);
    System.println(back.active);
    System.println(back.address.city);
    System.println(back.address.zip);
    System.println(back.tags[0]);
    System.println(back.tags[1]);
    System.println(back.scores[2]);
    System.println(Json.serialize(back));
}

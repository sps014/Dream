// Typed instance `WebWorkerPool.dispatch` / `dispatch_async`.

fun square(n: int): int {
    return n * n;
}

async fun bump(n: int): int {
    await Time.sleep(1);
    return n + 1;
}

async fun main(): void {
    let pool = WebWorkerPool(2);
    let a = pool.dispatch(3, square);
    let b = pool.dispatch(4, square);
    let c = pool.dispatch_async(5, bump);
    System.println((await a).to_string());
    System.println((await b).to_string());
    System.println((await c).to_string());
    pool.shutdown();
}

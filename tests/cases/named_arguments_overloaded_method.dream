// Named arguments work on overloaded instance methods.

import system;
class Calc {
    public fun add(x: int): int {
        return x;
    }

    public fun add(x: int, y: int): int {
        return x + y;
    }
}

fun main(): void {
    let c = Calc();
    System.println(c.add(x: 5));
    System.println(c.add(x: 2, y: 3));
}

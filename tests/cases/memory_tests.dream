class Node {
    public value: int;
    public next: Option<Node>;

    constructor(value: int, next: Option<Node>) {
        this.value = value;
        this.next = next;
    }
}

fun create_list(n: int): Option<Node> {
    if (n <= 0 ) {
        return Option.None;
    }
    let no_next: Option<Node> = Option.None;
    let head = Node(n, no_next);
    let curr = head;
    let i = n - 1;
    while (i > 0 ) {
        let nxt = Node(i, no_next);
        curr.next = Option.Some(nxt);
        curr = nxt;
        i = i - 1;
    }
    return Option.Some(head);
}

fun main(): void {
    // Allocate a large linked list to test allocator and ARC performance
    let list = create_list(10000);
    System.print("Memory was allocated and freed successfully!\n");
}

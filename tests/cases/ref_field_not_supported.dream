// v1 limitation: only local variables/parameters are valid `ref` targets (see
// `Analyzer::analyze_ref_argument`); a struct field is not yet an addressable place.
struct Counter {
    public value: int;
    constructor() { this.value = 0; }
}

fun increment(ref x: int): void {
    x = x + 1;
}

fun main(): void {
    let c: Counter = Counter();
    increment(ref c.value);
}

// v1 limitation: a lambda may not declare a `ref` parameter — every lambda is invoked through the
// `fun(...)` funcbox/`call_indirect` ABI, which has no `ref`-slot ABI yet (see `analyze_lambda`).
fun main(): void {
    let inc: fun(int): int = (ref n: int) => {
        n = n + 1;
        return n;
    };
    let a: int = 5;
    System.println(inc(a));
}

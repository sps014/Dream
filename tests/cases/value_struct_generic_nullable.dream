// A generic field substituted to an optional value struct (`Wrapper<Point>.inner : Option<Point>`)
// is supported per instantiation: `Option<T>` makes "no value" explicit regardless of whether `T`
// is a value or reference type.

import system;
struct Point {
    public x: int;

    public constructor(x: int) {
        this.x = x;
    }
}

struct Wrapper<T> {
    public inner: Option<T>;

    public constructor(inner: Option<T>) {
        this.inner = inner;
    }
}

fun main(): void {
    let w = Wrapper<Point>(Option.Some(Point(1)));
    let p: Point = w.inner ?? Point(-1);
    System.println(p.x);

    let no_point: Option<Point> = Option.None;
    let empty = Wrapper<Point>(no_point);
    let q: Point = empty.inner ?? Point(-1);
    System.println(q.x);
}

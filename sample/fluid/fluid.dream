// 2D stable-fluids (Jos Stam) — interactive CPU sim + `@compute` kernels (WGSL emitted for the
// browser host). The live loop runs on the CPU so auto-motion and drag work even when WebGPU is
// missing or hangs; kernels remain in the module for the compute codegen demo.
//
// Build: cargo run -- sample/fluid/fluid.dream
// Browser: serve repo root, open fluid.html. Drag to paint.

import system;
import system.gpu;

@compute(8, 8)
fun add_force(vx: GpuBuffer<float>, vy: GpuBuffer<float>, dye: GpuBuffer<float>, n: int): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x >= n || y >= n) { return; }
    let i = y * n + x;
    let cx: float = n / 2;
    let cy: float = n / 2;
    let dx: float = (float)x - cx;
    let dy: float = (float)y - cy;
    let d2: float = dx * dx + dy * dy;
    let rad: float = 10.0;
    if (d2 < rad * rad) {
        let w: float = 1.0 - d2 / (rad * rad);
        vx[i] = vx[i] + 1.5 * w;
        vy[i] = vy[i] + 0.8 * w;
        dye[i] = dye[i] + 0.45 * w;
        if (dye[i] > 1.0) { dye[i] = 1.0; }
    }
}

@compute(8, 8)
fun advect(src: GpuBuffer<float>, dst: GpuBuffer<float>, vx: GpuBuffer<float>, vy: GpuBuffer<float>, n: int): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x >= n || y >= n) { return; }
    let i = y * n + x;
    let dt: float = 0.85;
    let px: float = (float)x - dt * vx[i];
    let py: float = (float)y - dt * vy[i];
    if (px < 0.5) { px = 0.5; }
    if (py < 0.5) { py = 0.5; }
    let nm1: float = n - 2;
    if (px > nm1) { px = nm1; }
    if (py > nm1) { py = nm1; }
    let x0 = (int)px;
    let y0 = (int)py;
    let x1 = x0 + 1;
    let y1 = y0 + 1;
    let sx: float = px - x0;
    let sy: float = py - y0;
    let v00: float = src[y0 * n + x0];
    let v10: float = src[y0 * n + x1];
    let v01: float = src[y1 * n + x0];
    let v11: float = src[y1 * n + x1];
    dst[i] = (1.0 - sx) * ((1.0 - sy) * v00 + sy * v01) + sx * ((1.0 - sy) * v10 + sy * v11);
}

@compute(8, 8)
fun divergence(vx: GpuBuffer<float>, vy: GpuBuffer<float>, div: GpuBuffer<float>, n: int): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x <= 0 || y <= 0 || x >= n - 1 || y >= n - 1) { return; }
    let i = y * n + x;
    div[i] = 0.0 - 0.5 * (vx[i + 1] - vx[i - 1] + vy[i + n] - vy[i - n]);
}

@compute(8, 8)
fun pressure_jacobi(div: GpuBuffer<float>, p: GpuBuffer<float>, p_out: GpuBuffer<float>, n: int): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x <= 0 || y <= 0 || x >= n - 1 || y >= n - 1) { return; }
    let i = y * n + x;
    p_out[i] = (div[i] + p[i - 1] + p[i + 1] + p[i - n] + p[i + n]) * 0.25;
}

@compute(8, 8)
fun subtract_gradient(vx: GpuBuffer<float>, vy: GpuBuffer<float>, p: GpuBuffer<float>, n: int): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x <= 0 || y <= 0 || x >= n - 1 || y >= n - 1) { return; }
    let i = y * n + x;
    vx[i] = vx[i] - 0.5 * (p[i + 1] - p[i - 1]);
    vy[i] = vy[i] - 0.5 * (p[i + n] - p[i - n]);
}

/// UI + sim state for captureless DOM callbacks (one module global).
class FluidApp {
    public n: int;
    public mouse_x: int;
    public mouse_y: int;
    public prev_mx: int;
    public prev_my: int;
    public mouse_down: bool;
    public frame: int;
    public dens: float[];
    public dens_tmp: float[];
    public vx: float[];
    public vy: float[];
    public vx_tmp: float[];
    public vy_tmp: float[];
    public div: float[];
    public p0: float[];
    public p1: float[];

    public constructor() {
        this.n = 256;
        this.mouse_x = 128;
        this.mouse_y = 128;
        this.prev_mx = 128;
        this.prev_my = 128;
        this.mouse_down = false;
        this.frame = 0;
    }

    public fun init_fields(): void {
        let cells = this.n * this.n;
        this.dens = Buffer.alloc<float>(cells);
        this.dens_tmp = Buffer.alloc<float>(cells);
        this.vx = Buffer.alloc<float>(cells);
        this.vy = Buffer.alloc<float>(cells);
        this.vx_tmp = Buffer.alloc<float>(cells);
        this.vy_tmp = Buffer.alloc<float>(cells);
        this.div = Buffer.alloc<float>(cells);
        this.p0 = Buffer.alloc<float>(cells);
        this.p1 = Buffer.alloc<float>(cells);
    }
}

let app: FluidApp = FluidApp();

fun canvas_el(): js {
    return js.global.document.getElementById("fluid");
}

fun update_mouse_from_event(ev: js): void {
    let c = canvas_el();
    let rect = c.getBoundingClientRect();
    let w = rect.width.to_double();
    let h = rect.height.to_double();
    if (w < 1.0 || h < 1.0) { return; }
    let nx = (ev.clientX.to_double() - rect.left.to_double()) / w;
    let ny = (ev.clientY.to_double() - rect.top.to_double()) / h;
    if (nx < 0.0) { nx = 0.0; }
    if (ny < 0.0) { ny = 0.0; }
    if (nx > 1.0) { nx = 1.0; }
    if (ny > 1.0) { ny = 1.0; }
    app.prev_mx = app.mouse_x;
    app.prev_my = app.mouse_y;
    app.mouse_x = (int)(nx * (app.n - 1));
    app.mouse_y = (int)(ny * (app.n - 1));
}

fun on_pointer_down(ev: js): void {
    app.mouse_down = true;
    update_mouse_from_event(ev);
    let pid = ev.pointerId;
    if (!pid.is_null()) {
        canvas_el().setPointerCapture(pid);
    }
}

fun on_pointer_up(ev: js): void {
    app.mouse_down = false;
}

fun on_pointer_move(ev: js): void {
    if (app.mouse_down) {
        update_mouse_from_event(ev);
    } else {
        // Track position even when up so the next down doesn't jump.
        update_mouse_from_event(ev);
    }
}

fun splat(field: float[], n: int, cx: int, cy: int, amount: float, rad: int): void {
    let r2 = rad * rad;
    for (let y = cy - rad; y <= cy + rad; y = y + 1) {
        if (y < 0 || y >= n) { continue; }
        for (let x = cx - rad; x <= cx + rad; x = x + 1) {
            if (x < 0 || x >= n) { continue; }
            let dx = x - cx;
            let dy = y - cy;
            let d2 = dx * dx + dy * dy;
            if (d2 < r2) {
                let w: float = amount * (1.0 - (float)d2 / r2);
                let i = y * n + x;
                let v = field[i] + w;
                if (v > 1.0) { v = 1.0; }
                if (v < -2.0) { v = -2.0; }
                field[i] = v;
            }
        }
    }
}

fun sample_field(src: float[], n: int, px: float, py: float): float {
    if (px < 0.5) { px = 0.5; }
    if (py < 0.5) { py = 0.5; }
    let nm1: float = n - 2;
    if (px > nm1) { px = nm1; }
    if (py > nm1) { py = nm1; }
    let x0 = (int)px;
    let y0 = (int)py;
    let x1 = x0 + 1;
    let y1 = y0 + 1;
    let sx: float = px - x0;
    let sy: float = py - y0;
    let v00: float = src[y0 * n + x0];
    let v10: float = src[y0 * n + x1];
    let v01: float = src[y1 * n + x0];
    let v11: float = src[y1 * n + x1];
    return (1.0 - sx) * ((1.0 - sy) * v00 + sy * v01) + sx * ((1.0 - sy) * v10 + sy * v11);
}

fun advect_field(src: float[], dst: float[], vx: float[], vy: float[], n: int, dt: float): void {
    for (let y = 0; y < n; y = y + 1) {
        for (let x = 0; x < n; x = x + 1) {
            let i = y * n + x;
            let px: float = (float)x - dt * vx[i];
            let py: float = (float)y - dt * vy[i];
            dst[i] = sample_field(src, n, px, py);
        }
    }
}

fun project(vx: float[], vy: float[], div: float[], p0: float[], p1: float[], n: int): void {
    for (let y = 1; y < n - 1; y = y + 1) {
        for (let x = 1; x < n - 1; x = x + 1) {
            let i = y * n + x;
            div[i] = 0.0 - 0.5 * (vx[i + 1] - vx[i - 1] + vy[i + n] - vy[i - n]);
            p0[i] = 0.0;
        }
    }
    for (let k = 0; k < 3; k = k + 1) {
        for (let y = 1; y < n - 1; y = y + 1) {
            for (let x = 1; x < n - 1; x = x + 1) {
                let i = y * n + x;
                p1[i] = (div[i] + p0[i - 1] + p0[i + 1] + p0[i - n] + p0[i + n]) * 0.25;
            }
        }
        for (let y = 1; y < n - 1; y = y + 1) {
            for (let x = 1; x < n - 1; x = x + 1) {
                let i = y * n + x;
                p0[i] = (div[i] + p1[i - 1] + p1[i + 1] + p1[i - n] + p1[i + n]) * 0.25;
            }
        }
    }
    for (let y = 1; y < n - 1; y = y + 1) {
        for (let x = 1; x < n - 1; x = x + 1) {
            let i = y * n + x;
            vx[i] = vx[i] - 0.5 * (p0[i + 1] - p0[i - 1]);
            vy[i] = vy[i] - 0.5 * (p0[i + n] - p0[i - n]);
        }
    }
}

fun decay(field: float[], n: int, factor: float): void {
    let cells = n * n;
    for (let i = 0; i < cells; i = i + 1) {
        field[i] = field[i] * factor;
    }
}

async fun present_density(
    surface: GpuSurface,
    tex: GpuTexture,
    dens: float[],
    vx: float[],
    vy: float[],
    n: int,
    cells: int
): void {
    let bytes = Buffer.alloc<byte>(cells * 4);
    for (let i = 0; i < cells; i = i + 1) {
        let d = dens[i];
        if (d < 0.0) { d = 0.0; }
        if (d > 1.0) { d = 1.0; }
        let s: float = GpuMath.sqrt(vx[i] * vx[i] + vy[i] * vy[i]);
        if (s > 1.0) { s = 1.0; }
        // Multi-stop palette: deep indigo → cyan → lime → amber → magenta → white.
        let t: float = d * 0.75 + s * 0.25;
        let r: int = 0;
        let g: int = 0;
        let b: int = 0;
        if (t < 0.2) {
            let u = t / 0.2;
            r = (int)(10.0 + u * 20.0);
            g = (int)(8.0 + u * 40.0);
            b = (int)(40.0 + u * 120.0);
        } else if (t < 0.4) {
            let u = (t - 0.2) / 0.2;
            r = (int)(30.0 + u * 10.0);
            g = (int)(48.0 + u * 160.0);
            b = (int)(160.0 + u * 40.0);
        } else if (t < 0.6) {
            let u = (t - 0.4) / 0.2;
            r = (int)(40.0 + u * 180.0);
            g = (int)(208.0 - u * 40.0);
            b = (int)(200.0 - u * 160.0);
        } else if (t < 0.8) {
            let u = (t - 0.6) / 0.2;
            r = (int)(220.0 + u * 35.0);
            g = (int)(168.0 - u * 80.0);
            b = (int)(40.0 + u * 120.0);
        } else {
            let u = (t - 0.8) / 0.2;
            r = (int)(255.0);
            g = (int)(88.0 + u * 167.0);
            b = (int)(160.0 + u * 95.0);
        }
        bytes[i * 4] = (byte)r;
        bytes[i * 4 + 1] = (byte)g;
        bytes[i * 4 + 2] = (byte)b;
        bytes[i * 4 + 3] = (byte)255;
    }
    let wr = await tex.write_rgba(bytes);
    if (wr.is_err()) { return; }
    let bl = await GpuRenderPass.blit(surface, tex);
    if (bl.is_err()) { return; }
    let _p = await surface.present();
}

async fun main(): void {
    let init = await Gpu.try_init();
    if (init.is_err()) {
        System.println("WebGPU unavailable — fluid needs Gpu.try_init");
        return;
    }

    app.init_fields();
    let n = app.n;
    let cells = n * n;

    let surface_r = GpuSurface.from_canvas("fluid");
    if (surface_r.is_err()) {
        System.println("GpuSurface.from_canvas failed");
        return;
    }
    let surface = surface_r.unwrap_or(GpuSurface());
    surface.configure(n, n);
    let tex = GpuTexture.rgba8(n, n);

    // Seed a bright dye block so the first frame is never empty.
    for (let y = n / 3; y < (2 * n) / 3; y = y + 1) {
        for (let x = n / 3; x < (2 * n) / 3; x = x + 1) {
            app.dens[y * n + x] = 0.9;
        }
    }

    let canvas = canvas_el();
    canvas.style.touchAction = "none";
    canvas.addEventListener("pointerdown", on_pointer_down);
    canvas.addEventListener("pointerup", on_pointer_up);
    canvas.addEventListener("pointercancel", on_pointer_up);
    canvas.addEventListener("pointermove", on_pointer_move);
    canvas.addEventListener("mousedown", on_pointer_down);
    canvas.addEventListener("mouseup", on_pointer_up);
    canvas.addEventListener("mousemove", on_pointer_move);

    System.println("fluid running — drag to paint");
    await present_density(surface, tex, app.dens, app.vx, app.vy, n, cells);

    while (true) {
        let ang: double = 0.07d * app.frame;
        let ox = n / 2 + (int)(Math.cos(ang) * (n / 5));
        let oy = n / 2 + (int)(Math.sin(ang) * (n / 5));
        let fx: float = (float)((0.0d - Math.sin(ang)) * 1.2d);
        let fy: float = (float)(Math.cos(ang) * 1.2d);
        splat(app.dens, n, ox, oy, 0.35, 10);
        splat(app.vx, n, ox, oy, fx, 10);
        splat(app.vy, n, ox, oy, fy, 10);

        if (app.mouse_down) {
            let mfx: float = 0.8 * (app.mouse_x - app.prev_mx);
            let mfy: float = 0.8 * (app.mouse_y - app.prev_my);
            splat(app.dens, n, app.mouse_x, app.mouse_y, 0.95, 14);
            splat(app.vx, n, app.mouse_x, app.mouse_y, mfx, 14);
            splat(app.vy, n, app.mouse_x, app.mouse_y, mfy, 14);
            app.prev_mx = app.mouse_x;
            app.prev_my = app.mouse_y;
        }

        let dt: float = 0.9;
        advect_field(app.vx, app.vx_tmp, app.vx, app.vy, n, dt);
        advect_field(app.vy, app.vy_tmp, app.vx, app.vy, n, dt);
        for (let i = 0; i < cells; i = i + 1) {
            app.vx[i] = app.vx_tmp[i];
            app.vy[i] = app.vy_tmp[i];
        }
        project(app.vx, app.vy, app.div, app.p0, app.p1, n);

        advect_field(app.dens, app.dens_tmp, app.vx, app.vy, n, dt);
        for (let i = 0; i < cells; i = i + 1) {
            app.dens[i] = app.dens_tmp[i];
        }
        decay(app.dens, n, 0.996);
        decay(app.vx, n, 0.995);
        decay(app.vy, n, 0.995);

        await present_density(surface, tex, app.dens, app.vx, app.vy, n, cells);
        app.frame = app.frame + 1;
        await Gpu.frame();
    }
}

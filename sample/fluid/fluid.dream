// 2D stable-fluids (Jos Stam) on the GPU: `@compute` kernels batched with ComputePass.
// Splat / advect / project / decay / paint stay on-device; the CPU only tracks mouse + frame.
//
// Build: cargo run -- sample/fluid/fluid.dream
// Browser: serve repo root, open fluid.html. Drag to paint.

import system;
import system.gpu;

// Host packs dispatch extents into the first three i32 uniform slots (ex, ey, ez).
// Float uniforms must start at byte 12 — pad with unused i32s after `n`.

@compute(8, 8)
fun splat(
    dens: GpuBuffer<float>,
    vx: GpuBuffer<float>,
    vy: GpuBuffer<float>,
    n: int,
    _ey: int,
    _ez: int,
    cx: float,
    cy: float,
    dye_amt: float,
    fx: float,
    fy: float,
    rad: float
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x >= n || y >= n) { return; }
    let dx: float = (float)x - cx;
    let dy: float = (float)y - cy;
    let d2: float = dx * dx + dy * dy;
    let r2: float = rad * rad;
    if (d2 >= r2) { return; }
    let w: float = 1.0 - d2 / r2;
    let i = y * n + x;
    let d = dens[i] + dye_amt * w;
    if (d > 1.0) { d = 1.0; }
    if (d < 0.0) { d = 0.0; }
    dens[i] = d;
    vx[i] = vx[i] + fx * w;
    vy[i] = vy[i] + fy * w;
}

@compute(8, 8)
fun advect(
    @readonly src: GpuBuffer<float>,
    dst: GpuBuffer<float>,
    @readonly vx: GpuBuffer<float>,
    @readonly vy: GpuBuffer<float>,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x >= n || y >= n) { return; }
    let i = y * n + x;
    let dt: float = 0.9;
    let px: float = (float)x - dt * vx[i];
    let py: float = (float)y - dt * vy[i];
    if (px < 0.5) { px = 0.5; }
    if (py < 0.5) { py = 0.5; }
    let nm1: float = (float)(n - 2);
    if (px > nm1) { px = nm1; }
    if (py > nm1) { py = nm1; }
    let x0 = (int)px;
    let y0 = (int)py;
    let x1 = x0 + 1;
    let y1 = y0 + 1;
    let sx: float = px - x0;
    let sy: float = py - y0;
    let v00: float = src[y0 * n + x0];
    let v10: float = src[y0 * n + x1];
    let v01: float = src[y1 * n + x0];
    let v11: float = src[y1 * n + x1];
    dst[i] = (1.0 - sx) * ((1.0 - sy) * v00 + sy * v01) + sx * ((1.0 - sy) * v10 + sy * v11);
}

@compute(8, 8)
fun divergence(
    @readonly vx: GpuBuffer<float>,
    @readonly vy: GpuBuffer<float>,
    div: GpuBuffer<float>,
    p: GpuBuffer<float>,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x <= 0 || y <= 0 || x >= n - 1 || y >= n - 1) { return; }
    let i = y * n + x;
    div[i] = 0.0 - 0.5 * (vx[i + 1] - vx[i - 1] + vy[i + n] - vy[i - n]);
    p[i] = 0.0;
}

@compute(8, 8)
fun pressure_jacobi(
    @readonly div: GpuBuffer<float>,
    @readonly p: GpuBuffer<float>,
    p_out: GpuBuffer<float>,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x <= 0 || y <= 0 || x >= n - 1 || y >= n - 1) { return; }
    let i = y * n + x;
    p_out[i] = (div[i] + p[i - 1] + p[i + 1] + p[i - n] + p[i + n]) * 0.25;
}

@compute(8, 8)
fun subtract_gradient(
    vx: GpuBuffer<float>,
    vy: GpuBuffer<float>,
    @readonly p: GpuBuffer<float>,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x <= 0 || y <= 0 || x >= n - 1 || y >= n - 1) { return; }
    let i = y * n + x;
    vx[i] = vx[i] - 0.5 * (p[i + 1] - p[i - 1]);
    vy[i] = vy[i] - 0.5 * (p[i + n] - p[i - n]);
}

@compute(8, 8)
fun decay_field(
    field: GpuBuffer<float>,
    n: int,
    _ey: int,
    _ez: int,
    factor: float
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x >= n || y >= n) { return; }
    let i = y * n + x;
    field[i] = field[i] * factor;
}

@compute(8, 8)
fun paint(
    @readonly dens: GpuBuffer<float>,
    @readonly vx: GpuBuffer<float>,
    @readonly vy: GpuBuffer<float>,
    tex: GpuTexture,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x >= n || y >= n) { return; }
    let i = y * n + x;
    let d = dens[i];
    if (d < 0.0) { d = 0.0; }
    if (d > 1.0) { d = 1.0; }
    let s: float = GpuMath.sqrt(vx[i] * vx[i] + vy[i] * vy[i]);
    if (s > 1.0) { s = 1.0; }
    let t: float = d * 0.75 + s * 0.25;
    let r: float = 0.0;
    let g: float = 0.0;
    let b: float = 0.0;
    if (t < 0.2) {
        let u = t / 0.2;
        r = (10.0 + u * 20.0) / 255.0;
        g = (8.0 + u * 40.0) / 255.0;
        b = (40.0 + u * 120.0) / 255.0;
    } else if (t < 0.4) {
        let u = (t - 0.2) / 0.2;
        r = (30.0 + u * 10.0) / 255.0;
        g = (48.0 + u * 160.0) / 255.0;
        b = (160.0 + u * 40.0) / 255.0;
    } else if (t < 0.6) {
        let u = (t - 0.4) / 0.2;
        r = (40.0 + u * 180.0) / 255.0;
        g = (208.0 - u * 40.0) / 255.0;
        b = (200.0 - u * 160.0) / 255.0;
    } else if (t < 0.8) {
        let u = (t - 0.6) / 0.2;
        r = (220.0 + u * 35.0) / 255.0;
        g = (168.0 - u * 80.0) / 255.0;
        b = (40.0 + u * 120.0) / 255.0;
    } else {
        let u = (t - 0.8) / 0.2;
        r = 1.0;
        g = (88.0 + u * 167.0) / 255.0;
        b = (160.0 + u * 95.0) / 255.0;
    }
    Gpu.texture_store(tex, x, y, r, g, b, 1.0);
}

/// UI state for captureless DOM callbacks (one module global).
class FluidApp {
    public n: int;
    public mouse_x: int;
    public mouse_y: int;
    public prev_mx: int;
    public prev_my: int;
    public mouse_down: bool;
    public frame: int;

    public constructor() {
        this.n = 256;
        this.mouse_x = 128;
        this.mouse_y = 128;
        this.prev_mx = 128;
        this.prev_my = 128;
        this.mouse_down = false;
        this.frame = 0;
    }
}

let app: FluidApp = FluidApp();

fun canvas_el(): js {
    return js.global.document.getElementById("fluid");
}

fun update_mouse_from_event(ev: js): void {
    let c = canvas_el();
    let rect = c.getBoundingClientRect();
    let w = rect.width.to_double();
    let h = rect.height.to_double();
    if (w < 1.0 || h < 1.0) { return; }
    let nx = (ev.clientX.to_double() - rect.left.to_double()) / w;
    let ny = (ev.clientY.to_double() - rect.top.to_double()) / h;
    if (nx < 0.0) { nx = 0.0; }
    if (ny < 0.0) { ny = 0.0; }
    if (nx > 1.0) { nx = 1.0; }
    if (ny > 1.0) { ny = 1.0; }
    app.prev_mx = app.mouse_x;
    app.prev_my = app.mouse_y;
    app.mouse_x = (int)(nx * (app.n - 1));
    app.mouse_y = (int)(ny * (app.n - 1));
}

fun on_pointer_down(ev: js): void {
    app.mouse_down = true;
    update_mouse_from_event(ev);
    let pid = ev.pointerId;
    if (!pid.is_null()) {
        canvas_el().setPointerCapture(pid);
    }
}

fun on_pointer_up(ev: js): void {
    app.mouse_down = false;
}

fun on_pointer_move(ev: js): void {
    update_mouse_from_event(ev);
}

fun splat_uniforms(
    cx: float,
    cy: float,
    dye_amt: float,
    fx: float,
    fy: float,
    rad: float
): byte[] {
    return Uniforms.pack_f32([cx, cy, dye_amt, fx, fy, rad]);
}

async fun main(): void {
    let init = await Gpu.try_init();
    if (init.is_err()) {
        System.println("WebGPU unavailable — fluid needs Gpu.try_init");
        return;
    }

    let n = app.n;
    let cells = n * n;

    let surface_r = GpuSurface.from_canvas("fluid");
    if (surface_r.is_err()) {
        System.println("GpuSurface.from_canvas failed");
        return;
    }
    let surface = surface_r.unwrap_or(GpuSurface());
    surface.configure(n, n);
    let tex = GpuTexture.rgba8(n, n);

    let dens = GpuBuffer<float>.alloc(cells);
    let dens_tmp = GpuBuffer<float>.alloc(cells);
    let vx = GpuBuffer<float>.alloc(cells);
    let vx_tmp = GpuBuffer<float>.alloc(cells);
    let vy = GpuBuffer<float>.alloc(cells);
    let vy_tmp = GpuBuffer<float>.alloc(cells);
    let div = GpuBuffer<float>.alloc(cells);
    let p0 = GpuBuffer<float>.alloc(cells);
    let p1 = GpuBuffer<float>.alloc(cells);

    // Seed a bright dye block on the GPU so the first frame is never empty.
    let seed = Buffer.alloc<float>(cells);
    for (let y = n / 3; y < (2 * n) / 3; y = y + 1) {
        for (let x = n / 3; x < (2 * n) / 3; x = x + 1) {
            seed[y * n + x] = 0.9;
        }
    }
    dens.write(seed);

    let canvas = canvas_el();
    canvas.style.touchAction = "none";
    canvas.addEventListener("pointerdown", on_pointer_down);
    canvas.addEventListener("pointerup", on_pointer_up);
    canvas.addEventListener("pointercancel", on_pointer_up);
    canvas.addEventListener("pointermove", on_pointer_move);
    canvas.addEventListener("mousedown", on_pointer_down);
    canvas.addEventListener("mouseup", on_pointer_up);
    canvas.addEventListener("mousemove", on_pointer_move);

    System.println("fluid gpu — ComputePass Stam + paint");

    let empty_u = Buffer.alloc<byte>(0);
    let no_samplers = Buffer.alloc<int>(0);
    let dens_decay_u = Uniforms.pack_f32([0.996]);
    let vel_decay_u = Uniforms.pack_f32([0.995]);

    while (true) {
        let ang: double = 0.07d * app.frame;
        let ox: float = (float)(n / 2) + (float)(Math.cos(ang) * (n / 5));
        let oy: float = (float)(n / 2) + (float)(Math.sin(ang) * (n / 5));
        let fx: float = (float)((0.0d - Math.sin(ang)) * 1.2d);
        let fy: float = (float)(Math.cos(ang) * 1.2d);

        // Pass 1: forces + advect velocity (both advects read the same pre-update vx/vy).
        let pass1 = ComputePass.begin();
        pass1.dispatch_uniforms(
            "splat",
            [dens, vx, vy],
            n,
            n,
            1,
            splat_uniforms(ox, oy, 0.35, fx, fy, 10.0)
        );
        if (app.mouse_down) {
            let mfx: float = 0.8 * (float)(app.mouse_x - app.prev_mx);
            let mfy: float = 0.8 * (float)(app.mouse_y - app.prev_my);
            pass1.dispatch_uniforms(
                "splat",
                [dens, vx, vy],
                n,
                n,
                1,
                splat_uniforms((float)app.mouse_x, (float)app.mouse_y, 0.95, mfx, mfy, 14.0)
            );
            app.prev_mx = app.mouse_x;
            app.prev_my = app.mouse_y;
        }
        pass1.dispatch("advect", [vx, vx_tmp, vx, vy], n, n, 1);
        pass1.dispatch("advect", [vy, vy_tmp, vx, vy], n, n, 1);
        let s1 = await pass1.submit();
        if (s1.is_err()) {
            System.println("ComputePass 1 failed");
            return;
        }

        // Ping-pong velocity handles (no CPU readback).
        let swap_vx = vx;
        vx = vx_tmp;
        vx_tmp = swap_vx;
        let swap_vy = vy;
        vy = vy_tmp;
        vy_tmp = swap_vy;

        // Pass 2: project + advect dye.
        let pass2 = ComputePass.begin();
        pass2.dispatch("divergence", [vx, vy, div, p0], n, n, 1);
        // 3 Jacobi pairs (p0↔p1), same depth as the old CPU solver.
        pass2.dispatch("pressure_jacobi", [div, p0, p1], n, n, 1);
        pass2.dispatch("pressure_jacobi", [div, p1, p0], n, n, 1);
        pass2.dispatch("pressure_jacobi", [div, p0, p1], n, n, 1);
        pass2.dispatch("pressure_jacobi", [div, p1, p0], n, n, 1);
        pass2.dispatch("pressure_jacobi", [div, p0, p1], n, n, 1);
        pass2.dispatch("pressure_jacobi", [div, p1, p0], n, n, 1);
        pass2.dispatch("subtract_gradient", [vx, vy, p0], n, n, 1);
        pass2.dispatch("advect", [dens, dens_tmp, vx, vy], n, n, 1);
        let s2 = await pass2.submit();
        if (s2.is_err()) {
            System.println("ComputePass 2 failed");
            return;
        }

        let swap_d = dens;
        dens = dens_tmp;
        dens_tmp = swap_d;

        // Pass 3: decay + paint to storage texture.
        let pass3 = ComputePass.begin();
        pass3.dispatch_uniforms("decay_field", [dens], n, n, 1, dens_decay_u);
        pass3.dispatch_uniforms("decay_field", [vx], n, n, 1, vel_decay_u);
        pass3.dispatch_uniforms("decay_field", [vy], n, n, 1, vel_decay_u);
        pass3.dispatch_resources(
            "paint",
            [dens.id, vx.id, vy.id],
            [tex.id],
            no_samplers,
            n,
            n,
            1,
            empty_u
        );
        let s3 = await pass3.submit();
        if (s3.is_err()) {
            System.println("ComputePass 3 failed");
            return;
        }

        let bl = await GpuRenderPass.blit(surface, tex);
        if (bl.is_err()) { return; }
        let _p = await surface.present();
        app.frame = app.frame + 1;
        await Gpu.frame();
    }
}

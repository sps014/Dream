// Gray–Scott reaction–diffusion — continuous chemical simulation on the GPU.
// Two fields (u, v) evolve with diffusion + nonlinear reaction; paint maps v → color.
//
// Build: cargo run -- sample/compute/life/life.dream
// Browser: serve repo root, open life.html

import system;
import system.gpu;

// Host packs ex/ey/ez into the first three i32 uniform slots; floats follow at byte 12.

@compute(8, 8)
fun rd_step(
    @readonly u_in: GpuBuffer<float>,
    @readonly v_in: GpuBuffer<float>,
    u_out: GpuBuffer<float>,
    v_out: GpuBuffer<float>,
    n: int,
    _ey: int,
    _ez: int,
    du: float,
    dv: float,
    feed: float,
    kill: float
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x >= n || y >= n) { return; }
    let i = y * n + x;
    let xm = (x + n - 1) % n;
    let xp = (x + 1) % n;
    let ym = (y + n - 1) % n;
    let yp = (y + 1) % n;

    let u = u_in[i];
    let v = v_in[i];
    let lap_u = u_in[ym * n + x] + u_in[yp * n + x] + u_in[y * n + xm] + u_in[y * n + xp] - 4.0 * u;
    let lap_v = v_in[ym * n + x] + v_in[yp * n + x] + v_in[y * n + xm] + v_in[y * n + xp] - 4.0 * v;
    let uvv = u * v * v;
    let u2 = u + du * lap_u - uvv + feed * (1.0 - u);
    let v2 = v + dv * lap_v + uvv - (feed + kill) * v;
    if (u2 < 0.0) { u2 = 0.0; }
    if (u2 > 1.0) { u2 = 1.0; }
    if (v2 < 0.0) { v2 = 0.0; }
    if (v2 > 1.0) { v2 = 1.0; }
    u_out[i] = u2;
    v_out[i] = v2;
}

@compute(8, 8)
fun rd_paint(
    @readonly u: GpuBuffer<float>,
    @readonly v: GpuBuffer<float>,
    tex: GpuTexture,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x >= n || y >= n) { return; }
    let i = y * n + x;
    let t = v[i];
    let s = u[i];
    // Organic palette: deep ink → teal → lime → amber as reactant v grows.
    let r: float = 0.02 + t * 0.85 + s * 0.05;
    let g: float = 0.04 + t * 0.55 + (1.0 - s) * 0.25;
    let b: float = 0.10 + (1.0 - t) * 0.35 + s * 0.15;
    if (r > 1.0) { r = 1.0; }
    if (g > 1.0) { g = 1.0; }
    if (b > 1.0) { b = 1.0; }
    Gpu.texture_store(tex, x, y, r, g, b, 1.0);
}

fun seed_field(u: float[], v: float[], n: int): void {
    let cells = n * n;
    for (let i = 0; i < cells; i = i + 1) {
        u[i] = 1.0;
        v[i] = 0.0;
    }
    // Central square + a few offset blobs so patterns break symmetry.
    let r = n / 10;
    let cx = n / 2;
    let cy = n / 2;
    for (let y = cy - r; y <= cy + r; y = y + 1) {
        for (let x = cx - r; x <= cx + r; x = x + 1) {
            let i = y * n + x;
            u[i] = 0.50;
            v[i] = 0.25;
        }
    }
    let r2 = n / 16;
    for (let y = cy / 2 - r2; y <= cy / 2 + r2; y = y + 1) {
        for (let x = (3 * n) / 4 - r2; x <= (3 * n) / 4 + r2; x = x + 1) {
            let i = y * n + x;
            u[i] = 0.40;
            v[i] = 0.35;
        }
    }
    for (let y = (3 * n) / 4 - r2; y <= (3 * n) / 4 + r2; y = y + 1) {
        for (let x = n / 4 - r2; x <= n / 4 + r2; x = x + 1) {
            let i = y * n + x;
            u[i] = 0.45;
            v[i] = 0.30;
        }
    }
}

async fun run_browser(n: int): void {
    let cells = n * n;
    let host_u = Buffer.alloc<float>(cells);
    let host_v = Buffer.alloc<float>(cells);
    seed_field(host_u, host_v, n);

    let u = GpuBuffer<float>.from(host_u);
    let v = GpuBuffer<float>.from(host_v);
    let u2 = GpuBuffer<float>.alloc(cells);
    let v2 = GpuBuffer<float>.alloc(cells);
    let tex = GpuTexture.rgba8(n, n);

    let surface_r = GpuSurface.from_canvas("life");
    if (surface_r.is_err()) {
        System.println("GpuSurface.from_canvas failed");
        return;
    }
    let surface = surface_r.unwrap_or(GpuSurface());
    surface.configure(n, n);

    // Coral / mitosis-ish Gray–Scott parameters.
    let step_u = Uniforms.pack_f32([0.16, 0.08, 0.035, 0.065]);
    let empty_u = Buffer.alloc<byte>(0);
    let no_samplers = Buffer.alloc<int>(0);
    let steps_per_frame = 8;

    System.println("reaction-diffusion gpu — Gray-Scott");
    while (true) {
        let pass = ComputePass.begin();
        let s = 0;
        while (s < steps_per_frame) {
            if ((s % 2) == 0) {
                pass.dispatch_uniforms("rd_step", [u, v, u2, v2], n, n, 1, step_u);
            } else {
                pass.dispatch_uniforms("rd_step", [u2, v2, u, v], n, n, 1, step_u);
            }
            s = s + 1;
        }
        // Even step count → result in u/v after the last odd write? 
        // s=0: u,v → u2,v2; s=1: u2,v2 → u,v; ... s=7: u2,v2 → u,v. Paint u,v.
        pass.dispatch_resources(
            "rd_paint",
            [u.id, v.id],
            [tex.id],
            no_samplers,
            n,
            n,
            1,
            empty_u
        );
        let sub = await pass.submit();
        if (sub.is_err()) {
            System.println("ComputePass.submit failed");
            return;
        }

        let bl = await GpuRenderPass.blit(surface, tex);
        if (bl.is_err()) { return; }
        let _p = await surface.present();
        await Gpu.frame();
    }
}

async fun main(): void {
    let init = await Gpu.try_init();
    if (init.is_err()) {
        System.println("WebGPU unavailable — open life.html in a browser");
        return;
    }
    let surface_r = GpuSurface.from_canvas("life");
    if (surface_r.is_err()) {
        System.println("no canvas — open sample/compute/life/life.html (reaction-diffusion)");
        return;
    }
    await run_browser(256);
}

// Gray–Scott reaction–diffusion — continuous chemical simulation on the GPU.
// Two fields (u, v) evolve with diffusion + nonlinear reaction; paint maps chemistry → color.
//
// Build: cargo run -- sample/compute/life/life.dream
// Browser: serve repo root, open life.html

import system;
import system.gpu;

// Host packs ex/ey/ez into the first three i32 uniform slots; floats follow at byte 12.

@compute(8, 8)
fun rd_step(
    @readonly u_in: GpuBuffer<float>,
    @readonly v_in: GpuBuffer<float>,
    u_out: GpuBuffer<float>,
    v_out: GpuBuffer<float>,
    n: int,
    _ey: int,
    _ez: int,
    du: float,
    dv: float,
    feed: float,
    kill: float
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x >= n || y >= n) { return; }
    let i = y * n + x;
    let xm = (x + n - 1) % n;
    let xp = (x + 1) % n;
    let ym = (y + n - 1) % n;
    let yp = (y + 1) % n;

    let u = u_in[i];
    let v = v_in[i];
    // 9-point Laplacian (corners weighted) — smoother fronts than 5-point.
    let lap_u = 0.2 * (u_in[ym * n + x] + u_in[yp * n + x] + u_in[y * n + xm] + u_in[y * n + xp])
        + 0.05 * (u_in[ym * n + xm] + u_in[ym * n + xp] + u_in[yp * n + xm] + u_in[yp * n + xp])
        - u;
    let lap_v = 0.2 * (v_in[ym * n + x] + v_in[yp * n + x] + v_in[y * n + xm] + v_in[y * n + xp])
        + 0.05 * (v_in[ym * n + xm] + v_in[ym * n + xp] + v_in[yp * n + xm] + v_in[yp * n + xp])
        - v;
    let uvv = u * v * v;
    let u2 = u + du * lap_u - uvv + feed * (1.0 - u);
    let v2 = v + dv * lap_v + uvv - (feed + kill) * v;
    if (u2 < 0.0) { u2 = 0.0; }
    if (u2 > 1.0) { u2 = 1.0; }
    if (v2 < 0.0) { v2 = 0.0; }
    if (v2 > 1.0) { v2 = 1.0; }
    u_out[i] = u2;
    v_out[i] = v2;
}

@compute(8, 8)
fun rd_paint(
    @readonly u_buf: GpuBuffer<float>,
    @readonly v_buf: GpuBuffer<float>,
    tex: GpuTexture,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if (x >= n || y >= n) { return; }
    let i = y * n + x;
    let xm = (x + n - 1) % n;
    let xp = (x + 1) % n;
    let ym = (y + n - 1) % n;
    let yp = (y + 1) % n;

    let vv = v_buf[i];
    let uu = u_buf[i];
    // Edge glow from local v gradient — brightens reaction fronts.
    let gx = v_buf[y * n + xp] - v_buf[y * n + xm];
    let gy = v_buf[yp * n + x] - v_buf[ym * n + x];
    let grad = GpuMath.sqrt(gx * gx + gy * gy);
    if (grad > 1.0) { grad = 1.0; }

    let t = vv * 1.15;
    if (t < 0.0) { t = 0.0; }
    if (t > 1.0) { t = 1.0; }
    // Ease midtones so thin filaments pop.
    t = t * t * (3.0 - 2.0 * t);

    // Ember / seafoam on near-black: void → teal → mint → gold → coral → white-hot.
    let r: float = 0.0;
    let g: float = 0.0;
    let b: float = 0.0;
    if (t < 0.15) {
        let w = t / 0.15;
        r = 0.01 + w * 0.02;
        g = 0.02 + w * 0.08;
        b = 0.04 + w * 0.18;
    } else if (t < 0.35) {
        let w = (t - 0.15) / 0.20;
        r = 0.03 + w * 0.05;
        g = 0.10 + w * 0.45;
        b = 0.22 + w * 0.35;
    } else if (t < 0.55) {
        let w = (t - 0.35) / 0.20;
        r = 0.08 + w * 0.20;
        g = 0.55 + w * 0.35;
        b = 0.57 - w * 0.25;
    } else if (t < 0.75) {
        let w = (t - 0.55) / 0.20;
        r = 0.28 + w * 0.55;
        g = 0.90 - w * 0.25;
        b = 0.32 - w * 0.20;
    } else {
        let w = (t - 0.75) / 0.25;
        r = 0.83 + w * 0.17;
        g = 0.65 - w * 0.25;
        b = 0.12 + w * 0.55;
    }

    // Substrate (u) cools the background slightly; fronts get a warm halo.
    let cool = (1.0 - uu) * 0.08;
    r = r - cool * 0.15;
    g = g + cool * 0.05;
    b = b + cool * 0.12;
    r = r + grad * 0.55;
    g = g + grad * 0.35;
    b = b + grad * 0.15;
    if (r < 0.0) { r = 0.0; }
    if (g < 0.0) { g = 0.0; }
    if (b < 0.0) { b = 0.0; }
    if (r > 1.0) { r = 1.0; }
    if (g > 1.0) { g = 1.0; }
    if (b > 1.0) { b = 1.0; }
    Gpu.texture_store(tex, x, y, r, g, b, 1.0);
}

fun soft_disk(u: float[], v: float[], n: int, cx: int, cy: int, rad: int, v0: float): void {
    let r2 = rad * rad;
    for (let y = cy - rad; y <= cy + rad; y = y + 1) {
        if (y < 0 || y >= n) { continue; }
        for (let x = cx - rad; x <= cx + rad; x = x + 1) {
            if (x < 0 || x >= n) { continue; }
            let dx = x - cx;
            let dy = y - cy;
            let d2 = dx * dx + dy * dy;
            if (d2 <= r2) {
                let w: float = 1.0 - (float)d2 / (float)r2;
                w = w * w;
                let i = y * n + x;
                let nv = v[i] + v0 * w;
                if (nv > 1.0) { nv = 1.0; }
                v[i] = nv;
                u[i] = 1.0 - 0.55 * nv;
            }
        }
    }
}

fun seed_field(u: float[], v: float[], n: int): void {
    let cells = n * n;
    for (let i = 0; i < cells; i = i + 1) {
        u[i] = 1.0;
        v[i] = 0.0;
    }
    // Soft disks + a thin ring — breaks symmetry into coral / worm growth.
    soft_disk(u, v, n, n / 2, n / 2, n / 14, 0.55);
    soft_disk(u, v, n, n / 3, (2 * n) / 5, n / 22, 0.70);
    soft_disk(u, v, n, (2 * n) / 3, (3 * n) / 5, n / 20, 0.65);
    soft_disk(u, v, n, n / 4, (3 * n) / 4, n / 28, 0.80);
    soft_disk(u, v, n, (3 * n) / 4, n / 5, n / 26, 0.75);

    let cx = n / 2;
    let cy = n / 2;
    let r_in = n / 9;
    let r_out = n / 7;
    for (let y = cy - r_out; y <= cy + r_out; y = y + 1) {
        for (let x = cx - r_out; x <= cx + r_out; x = x + 1) {
            let dx = x - cx;
            let dy = y - cy;
            let d2 = dx * dx + dy * dy;
            if (d2 >= r_in * r_in && d2 <= r_out * r_out) {
                let i = y * n + x;
                v[i] = 0.45;
                u[i] = 0.50;
            }
        }
    }
}

async fun run_browser(n: int): void {
    let cells = n * n;
    let host_u = Buffer.alloc<float>(cells);
    let host_v = Buffer.alloc<float>(cells);
    seed_field(host_u, host_v, n);

    let u = GpuBuffer<float>.from(host_u);
    let v = GpuBuffer<float>.from(host_v);
    let u2 = GpuBuffer<float>.alloc(cells);
    let v2 = GpuBuffer<float>.alloc(cells);
    let tex = GpuTexture.rgba8(n, n);

    let surface_r = GpuSurface.from_canvas("life");
    if (surface_r.is_err()) {
        System.println("GpuSurface.from_canvas failed");
        return;
    }
    let surface = surface_r.unwrap_or(GpuSurface());
    surface.configure(n, n);

    // Fingerprint / coral Gray–Scott (Du, Dv, feed, kill).
    let step_u = Uniforms.pack_f32([0.21, 0.105, 0.026, 0.051]);
    let empty_u = Buffer.alloc<byte>(0);
    let no_samplers = Buffer.alloc<int>(0);
    let steps_per_frame = 14;

    System.println("reaction-diffusion gpu — Gray-Scott");
    while (true) {
        let pass = ComputePass.begin();
        let s = 0;
        while (s < steps_per_frame) {
            if ((s % 2) == 0) {
                pass.dispatch_uniforms("rd_step", [u, v, u2, v2], n, n, 1, step_u);
            } else {
                pass.dispatch_uniforms("rd_step", [u2, v2, u, v], n, n, 1, step_u);
            }
            s = s + 1;
        }
        pass.dispatch_resources(
            "rd_paint",
            [u.id, v.id],
            [tex.id],
            no_samplers,
            n,
            n,
            1,
            empty_u
        );
        let sub = await pass.submit();
        if (sub.is_err()) {
            System.println("ComputePass.submit failed");
            return;
        }

        let bl = await GpuRenderPass.blit(surface, tex);
        if (bl.is_err()) { return; }
        let _p = await surface.present();
        await Gpu.frame();
    }
}

async fun main(): void {
    let init = await Gpu.try_init();
    if (init.is_err()) {
        System.println("WebGPU unavailable — open life.html in a browser");
        return;
    }
    let surface_r = GpuSurface.from_canvas("life");
    if (surface_r.is_err()) {
        System.println("no canvas — open sample/compute/life/life.html (reaction-diffusion)");
        return;
    }
    await run_browser(768);
}

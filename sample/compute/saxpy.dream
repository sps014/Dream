// Minimal @compute smoke sample (compile + print).
import system.gpu;

@compute(64)
fun saxpy(a: float, x: GpuBuffer<float>, y: GpuBuffer<float>, out: GpuBuffer<float>, n: int): void {
    let i = global_id.x;
    if (i < n) {
        out[i] = a * x[i] + y[i];
    }
}

fun main(): void {
    System.println("compute ok");
}

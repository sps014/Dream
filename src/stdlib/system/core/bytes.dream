module system.core;

// `Bytes` - raw byte-blit conversions between a blittable value and a `byte[]` buffer, backing two
// compiler intrinsics. These underpin the value-copy WebWorker boundary: a value is flattened to a
// byte buffer on one side and rebuilt from an identical buffer on the other, with no marshalling.
//
// Only blittable values (`T : unmanaged`, recursively free of reference fields) are safe to copy
// this way - a raw byte copy of a heap reference would carry a pointer that is meaningless in
// another memory space.
public class Bytes {
    // Copy the raw bytes of blittable `value` into a fresh `byte[]` (one element per byte).
    @intrinsic("to_bytes")
    static extern fun of<T : unmanaged>(value: T): byte[];

    // Reconstruct a blittable `T` from a `byte[]` buffer produced by `Bytes.of<T>`.
    @intrinsic("from_bytes")
    static extern fun to<T : unmanaged>(bytes: byte[]): T;

    // Encodes `bytes` as a `string` with one codepoint (0-255) per byte - lossless, since every
    // byte value is a valid standalone Unicode codepoint, and the inverse of `fromWireString`.
    // Used to carry an arbitrary byte buffer over a channel that only understands `string`s (the
    // `WebWorker` wire), without needing a second, binary-native transport.
    public static fun toWireString(bytes: byte[]): string {
        let n = bytes.size();
        let s = string.alloc(n);
        for (let i = 0; i < n; i = i + 1) {
            string.set(s, i, (char)bytes[i]);
        }
        return s;
    }

    // The inverse of `toWireString`.
    public static fun fromWireString(s: string): byte[] {
        let n = s.size();
        let out = Buffer.alloc<byte>(n);
        for (let i = 0; i < n; i = i + 1) {
            out[i] = (byte)s.char_at(i).to_int();
        }
        return out;
    }

    // Encodes a `WebWorker`-safe value of type `T` as the `string` the worker wire carries:
    // identity when `T` is `string` itself, otherwise a raw byte-blit (`T` must be `unmanaged`)
    // re-encoded via `toWireString`. Used by `WebWorker<TIn, TOut>`/`WebWorker.map`/
    // `WebWorkerPool.dispatch` to marshal an arbitrary `TIn`/`TOut` without a second wire format.
    @intrinsic("wire_encode")
    static extern fun toWire<T>(value: T): string;

    // The inverse of `toWire`.
    @intrinsic("wire_decode")
    static extern fun fromWire<T>(text: string): T;
}

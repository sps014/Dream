module system.text;

// Parsed regex syntax tree, produced by `RegexParser` (regex_parser.dream) and consumed by
// `RegexCompiler` (regex_program.dream). Modeled after RE2's `Regexp` node (re2/regexp.h), scoped
// to the operators this engine supports, and shaped like the rest of the stdlib's own recursive
// trees (see `JsonValue`): a flat `kind` tag plus every field any variant might need, rather than
// a discriminated union. `left`/`right` use `List<RegexNode>` (0 or 1 element) instead of
// `Option<RegexNode>` to avoid the compiler's reference-cycle check, which is conservative about
// a class holding a field of its own type directly.

// The kind of a parsed regex node.
public enum RegexNodeKind {
    Alt,      // left | right
    Cat,      // left then right
    Lit,      // a single literal character (`ch`)
    Class,    // a character class: `ranges` (lo, hi pairs) plus `negate`
    AnyChar,  // `.` — ranges are resolved at compile time from the dotall flag
    Paren,    // a group; `cap` >= 0 is a capturing group's 1-based index (0 = the whole-match
              // wrapper the parser adds), `cap` == -1 is a non-capturing `(?:...)` group
    Star,     // left*
    Plus,     // left+
    Quest,    // left?
    Assert,   // a zero-width assertion; `empty_kind` selects which one
    Nothing,  // matches the empty string and consumes nothing (compiles to zero instructions)
}

// Zero-width assertion kinds, one per node (re2/prog.h's `EmptyOp` is a bitmask since one RE2
// instruction can combine several; this engine never needs more than one assertion per node, so a
// plain tag is enough).
public enum RegexEmptyKind {
    BeginLine,
    EndLine,
    BeginText,
    EndText,
    WordBoundary,
    NonWordBoundary,
}

public class RegexNode {
    public kind: RegexNodeKind;
    public left: List<RegexNode>;
    public right: List<RegexNode>;
    public ch: char;
    public ranges: List<char>;
    public negate: bool;
    public cap: int;
    public greedy: bool;
    public empty_kind: RegexEmptyKind;

    constructor(kind: RegexNodeKind, left: List<RegexNode>, right: List<RegexNode>, ch: char, ranges: List<char>, negate: bool, cap: int, greedy: bool, empty_kind: RegexEmptyKind) {
        this.kind = kind;
        this.left = left;
        this.right = right;
        this.ch = ch;
        this.ranges = ranges;
        this.negate = negate;
        this.cap = cap;
        this.greedy = greedy;
        this.empty_kind = empty_kind;
    }

    fun one_child(node: RegexNode): List<RegexNode> {
        let l = List<RegexNode>();
        l.push(node);
        return l;
    }

    // The left (or only) child of a unary/binary node, or `Nothing` if absent.
    public fun left_child(): RegexNode {
        return this.left.get(0).unwrap_or(RegexNode.nothing());
    }

    // The right child of a binary node, or `Nothing` if absent.
    public fun right_child(): RegexNode {
        return this.right.get(0).unwrap_or(RegexNode.nothing());
    }

    public static fun nothing(): RegexNode {
        let n = RegexNode(RegexNodeKind.Nothing, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, true, RegexEmptyKind.BeginLine);
        return n;
    }

    public static fun lit(ch: char): RegexNode {
        return RegexNode(RegexNodeKind.Lit, List<RegexNode>(), List<RegexNode>(), ch, List<char>(), false, 0, true, RegexEmptyKind.BeginLine);
    }

    public static fun any_char(): RegexNode {
        return RegexNode(RegexNodeKind.AnyChar, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, true, RegexEmptyKind.BeginLine);
    }

    // `ranges` is a flat list of (lo, hi) pairs. `negate` flips membership: a `[^...]` class.
    public static fun char_class(ranges: List<char>, negate: bool): RegexNode {
        return RegexNode(RegexNodeKind.Class, List<RegexNode>(), List<RegexNode>(), ' ', ranges, negate, 0, true, RegexEmptyKind.BeginLine);
    }

    public static fun cat(left: RegexNode, right: RegexNode): RegexNode {
        let n = RegexNode(RegexNodeKind.Cat, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, true, RegexEmptyKind.BeginLine);
        n.left = n.one_child(left);
        n.right = n.one_child(right);
        return n;
    }

    public static fun alt(left: RegexNode, right: RegexNode): RegexNode {
        let n = RegexNode(RegexNodeKind.Alt, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, true, RegexEmptyKind.BeginLine);
        n.left = n.one_child(left);
        n.right = n.one_child(right);
        return n;
    }

    // `cap` >= 0 for a capturing group (0 is reserved for the whole-match wrapper the parser
    // installs around the entire pattern); `cap` == -1 for a non-capturing `(?:...)` group.
    public static fun paren(inner: RegexNode, cap: int): RegexNode {
        let n = RegexNode(RegexNodeKind.Paren, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, cap, true, RegexEmptyKind.BeginLine);
        n.left = n.one_child(inner);
        return n;
    }

    public static fun star(inner: RegexNode, greedy: bool): RegexNode {
        let n = RegexNode(RegexNodeKind.Star, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, greedy, RegexEmptyKind.BeginLine);
        n.left = n.one_child(inner);
        return n;
    }

    public static fun plus(inner: RegexNode, greedy: bool): RegexNode {
        let n = RegexNode(RegexNodeKind.Plus, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, greedy, RegexEmptyKind.BeginLine);
        n.left = n.one_child(inner);
        return n;
    }

    public static fun quest(inner: RegexNode, greedy: bool): RegexNode {
        let n = RegexNode(RegexNodeKind.Quest, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, greedy, RegexEmptyKind.BeginLine);
        n.left = n.one_child(inner);
        return n;
    }

    public static fun assertion(kind: RegexEmptyKind): RegexNode {
        return RegexNode(RegexNodeKind.Assert, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, true, kind);
    }
}

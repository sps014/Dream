module system.text;

// Regular expressions — a self-contained engine, no host runtime involved. `Regex(pattern, flags)`
// parses and compiles the pattern once (see `regex_parser.dream` and `regex_program.dream`), then
// `test`/`replace`/`match` run it on Dream's own Pike-VM implementation (`regex_vm.dream`). See
// docs/stdlib/regex.md for the supported syntax subset.
public class Regex {
    pattern: string;
    flags: string;
    prog: RegexInst[];
    ngroup: int;
    ignore_case: bool;
    multiline: bool;
    dot_all: bool;
    global: bool;

    public constructor(pattern: string, flags: string) {
        this.pattern = pattern;
        this.flags = flags;
        this.ignore_case = flags.contains("i");
        this.multiline = flags.contains("m");
        this.dot_all = flags.contains("s");
        this.global = flags.contains("g");

        let parser = RegexParser(pattern);
        let ast = parser.parse();
        let compiler = RegexCompiler(this.ignore_case, this.dot_all);
        this.prog = compiler.compile(ast);
        this.ngroup = parser.groups();
    }

    fun vm(): RegexVM {
        return RegexVM(this.prog, this.ngroup, this.multiline);
    }

    // True if `input` contains a match for this pattern.
    public fun test(input: string): bool {
        return this.vm().find(input, 0).is_some();
    }

    // Returns `input` with every match replaced by `replacement` (`g` flag: every match; without
    // it, only the first). `replacement` may reference capture groups with `$1`.."$9" or the whole
    // match with `$&`; `$$` is a literal `$`.
    public fun replace(input: string, replacement: string): string {
        let n = input.length;
        let sb = StringBuilder();
        let vm = this.vm();
        let pos = 0;
        let going = true;
        while (going) {
            if (pos > n) {
                going = false;
            } else {
                let m_opt = vm.find(input, pos);
                switch (m_opt) {
                    Some(m) => {
                        let s = m.start();
                        let e = m.end();
                        sb.append(input.substring(pos, s));
                        this.append_replacement(sb, replacement, input, m);
                        if (e > s) {
                            pos = e;
                        } else {
                            if (s < n) {
                                sb.append(input.substring(s, s + 1));
                            }
                            pos = s + 1;
                        }
                        if (this.global == false) {
                            going = false;
                        }
                    },
                    None => {
                        going = false;
                    },
                }
            }
        }
        sb.append(input.substring(pos, n));
        return sb.build();
    }

    fun append_replacement(sb: StringBuilder, replacement: string, input: string, m: RegexMatch): void {
        let rn = replacement.length;
        let i = 0;
        while (i < rn) {
            let c = replacement.char_at(i);
            if ((c == '$') && (i + 1 < rn)) {
                let next = replacement.char_at(i + 1);
                if (next == '$') {
                    sb.append_char('$');
                    i = i + 2;
                } else if (next == '&') {
                    sb.append(m.group_text(input, 0));
                    i = i + 2;
                } else if (next.is_digit()) {
                    let zero = '0';
                    let g = next.to_int() - zero.to_int();
                    sb.append(m.group_text(input, g));
                    i = i + 2;
                } else {
                    sb.append_char(c);
                    i = i + 1;
                }
            } else {
                sb.append_char(c);
                i = i + 1;
            }
        }
    }

    // Returns the matches in `input` as an array: every full match with the `g` flag, otherwise
    // the first match's full text followed by each capture group (a group that didn't
    // participate is "").
    public fun match(input: string): string[] {
        let vm = this.vm();
        let n = input.length;
        if (this.global) {
            let results = List<string>();
            let pos = 0;
            let going = true;
            while (going) {
                if (pos > n) {
                    going = false;
                } else {
                    let m_opt = vm.find(input, pos);
                    switch (m_opt) {
                        Some(m) => {
                            results.push(m.group_text(input, 0));
                            let s = m.start();
                            let e = m.end();
                            if (e > s) {
                                pos = e;
                            } else {
                                pos = s + 1;
                            }
                        },
                        None => {
                            going = false;
                        },
                    }
                }
            }
            return this.to_array(results);
        }
        let m_opt = vm.find(input, 0);
        return switch (m_opt) {
            Some(m) => this.groups_array(input, m),
            None => Buffer.alloc<string>(0),
        };
    }

    fun groups_array(input: string, m: RegexMatch): string[] {
        let count = this.ngroup + 1;
        let arr = Buffer.alloc<string>(count);
        let i = 0;
        while (i < count) {
            arr[i] = m.group_text(input, i);
            i = i + 1;
        }
        return arr;
    }

    fun to_array(list: List<string>): string[] {
        let arr = Buffer.alloc<string>(list.length);
        let i = 0;
        while (i < list.length) {
            arr[i] = list.get(i).unwrap_or("");
            i = i + 1;
        }
        return arr;
    }
}

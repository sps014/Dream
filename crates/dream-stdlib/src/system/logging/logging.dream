module system.logging;

// Severity levels ordered from most to least verbose.
public enum LogLevel {
    Trace,
    Debug,
    Info,
    Warn,
    Error,
}

// One log event ready for handlers.
public class LogRecord {
    // Severity of this record.
    public level: LogLevel;
    // Logger name that produced this record.
    public name: string;
    // Message text.
    public message: string;
    // UTC epoch milliseconds when the record was created.
    public timestamp_ms: long;

    // Builds a record from its fields.
    constructor(level: LogLevel, name: string, message: string, timestamp_ms: long) {
        this.level = level;
        this.name = name;
        this.message = message;
        this.timestamp_ms = timestamp_ms;
    }
}

// Sink that receives log records.
public interface LogHandler {
    fun emit(record: LogRecord): void;
}

fun level_name(level: LogLevel): string {
    if (level == LogLevel.Trace) {
        return "TRACE";
    }
    if (level == LogLevel.Debug) {
        return "DEBUG";
    }
    if (level == LogLevel.Info) {
        return "INFO";
    }
    if (level == LogLevel.Warn) {
        return "WARN";
    }
    return "ERROR";
}

// Writes formatted lines to stdout via `System.println`.
public class ConsoleHandler : LogHandler {
    // Creates a console handler.
    constructor() { }

    // Prints `[LEVEL] name: message`.
    public fun emit(record: LogRecord): void {
        System.println("[" + level_name(record.level) + "] " + record.name + ": " + record.message);
    }
}

// Appends formatted lines to a file (synchronous host write).
public class FileHandler : LogHandler {
    path: string;

    @js("Dream", "fileAppend")
    static extern fun file_append(path: string, content: string): long;

    // Creates a handler that appends to `path`.
    constructor(path: string) {
        this.path = path;
    }

    // Appends one formatted line to the file.
    public fun emit(record: LogRecord): void {
        let line = "[" + level_name(record.level) + "] " + record.name + ": " + record.message + "\n";
        FileHandler.file_append(this.path, line);
    }
}

// Named logger with a minimum level and zero or more handlers.
public class Logger {
    name: string;
    level: LogLevel;
    handlers: List<LogHandler>;

    constructor(name: string) {
        this.name = name;
        this.level = LogLevel.Info;
        this.handlers = List<LogHandler>();
    }

    // Returns the named logger, creating it on first use.
    public static fun get(name: string): Logger {
        let existing = loggers_map.get(name);
        if (existing.is_some()) {
            return existing.unwrap_or(Logger(name));
        }
        let created = Logger(name);
        loggers_map.set(name, created);
        return created;
    }

    // Sets the minimum level; lower-severity records are dropped.
    public fun set_level(level: LogLevel): void {
        this.level = level;
    }

    // Registers an additional handler.
    public fun add_handler(h: LogHandler): void {
        this.handlers.push(h);
    }

    fun emit(level: LogLevel, msg: string): void {
        if (level < this.level) {
            return;
        }
        let record = LogRecord(level, this.name, msg, DateTime.utc_now().epoch_millis);
        let i = 0;
        while (i < this.handlers.size()) {
            switch (this.handlers.get(i)) {
                Some(h) => { h.emit(record); },
                None => { },
            }
            i = i + 1;
        }
    }

    // Logs at Trace.
    public fun trace(msg: string): void {
        this.emit(LogLevel.Trace, msg);
    }

    // Logs at Debug.
    public fun debug(msg: string): void {
        this.emit(LogLevel.Debug, msg);
    }

    // Logs at Info.
    public fun info(msg: string): void {
        this.emit(LogLevel.Info, msg);
    }

    // Logs at Warn.
    public fun warn(msg: string): void {
        this.emit(LogLevel.Warn, msg);
    }

    // Logs at Error.
    public fun error(msg: string): void {
        this.emit(LogLevel.Error, msg);
    }
}

// Process-wide registry of named loggers.
let loggers_map: Map<string, Logger> = Map<string, Logger>();

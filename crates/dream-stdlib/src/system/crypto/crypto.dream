module system.crypto;

// Host-backed digests and CSPRNG (`sha2` / `hmac` / `getrandom` natively; `node:crypto` or Web
// Crypto in `runtime/dream.js`). Hex/Base64 encoding lives in `system.encoding`.

// SHA-256 digest of `data` (32 bytes).
public class Sha256 {
    @js("Dream", "cryptoSha256")
    static extern fun hash(data: byte[]): byte[];
}

// SHA-512 digest of `data` (64 bytes).
public class Sha512 {
    @js("Dream", "cryptoSha512")
    static extern fun hash(data: byte[]): byte[];
}

// HMAC-SHA256 of `data` under `key` (32 bytes).
public class HmacSha256 {
    @js("Dream", "cryptoHmacSha256")
    static extern fun sign(key: byte[], data: byte[]): byte[];
}

// Cryptographically secure random bytes from the OS CSPRNG.
public class SecureRandom {
    // Allocates `n` random bytes (`n <= 0` yields an empty array).
    @js("Dream", "cryptoSecureRandomBytes")
    static extern fun bytes(n: int): byte[];

    // Fills `dest` in place with random bytes (length unchanged).
    @js("Dream", "cryptoSecureRandomFill")
    static extern fun fill(dest: byte[]): void;
}

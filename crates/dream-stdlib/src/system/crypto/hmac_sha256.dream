module system.crypto;

// HMAC-SHA256 keyed digest (32-byte output). Host-backed via `Dream.cryptoHmacSha256`.
public class HmacSha256 {
    @js("Dream", "cryptoHmacSha256")
    static extern fun sign_host(key: byte[], data: byte[]): byte[];

    // Computes HMAC-SHA256 of `data` under `key`.
    public static fun sign(key: byte[], data: byte[]): byte[] {
        return HmacSha256.sign_host(key, data);
    }
}

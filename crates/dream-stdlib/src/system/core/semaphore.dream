module system.core;

// Counting semaphore for limiting concurrent access to a shared resource.
public class Semaphore {
    permits: int;

    // Creates a semaphore with `initial` available permits.
    public constructor(initial: int) {
        this.permits = initial;
    }

    @intrinsic("shared_semaphore_acquire")
    static extern fun host_acquire(target: Semaphore): void;

    @intrinsic("shared_semaphore_release")
    static extern fun host_release(target: Semaphore): void;

    // Blocks (busy-waiting) until a permit is available, then takes one.
    public fun acquire(): void {
        Semaphore.host_acquire(this);
    }

    // Returns one permit.
    public fun release(): void {
        Semaphore.host_release(this);
    }
}

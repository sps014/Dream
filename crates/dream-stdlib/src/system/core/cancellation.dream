module system.core;

// Error raised when a cooperative cancellation token is already cancelled.
public class CancelledError : Error {
    _message: string;

    public constructor(message: string) {
        this._message = message;
    }

    // Human-readable description.
    public fun message(): string {
        return this._message;
    }

    // Stable machine code.
    public fun code(): string {
        return "ECANCELLED";
    }

    // Factory for a standard cancelled error.
    public static fun cancelled(): CancelledError {
        return CancelledError("operation cancelled");
    }
}

// Cooperative cancellation flag shared with tokens from a `CancellationSource`.
public class CancellationSource {
    _cancelled: bool;

    // Creates a source that is not yet cancelled.
    public constructor() {
        this._cancelled = false;
    }

    // True after `cancel` has been called.
    public fun is_cancelled(): bool {
        return this._cancelled;
    }

    // Marks this source (and all of its tokens) as cancelled.
    public fun cancel(): void {
        this._cancelled = true;
    }

    // Returns a token that observes this source's cancelled state.
    public fun token(): CancellationToken {
        return CancellationToken(this);
    }
}

// Read-only view of a `CancellationSource` for cooperative checks at await boundaries.
public class CancellationToken {
    _source: CancellationSource;

    public constructor(source: CancellationSource) {
        this._source = source;
    }

    // True when the owning source has been cancelled.
    public fun is_cancelled(): bool {
        return this._source.is_cancelled();
    }

    // Panics with `CancelledError` when already cancelled.
    public fun throw_if_cancelled(): void {
        if (this.is_cancelled()) {
            System.panic(CancelledError.cancelled().message());
        }
    }

    // `Ok(true)` when still running; `Err(CancelledError)` when cancelled.
    public fun check(): Result<bool, CancelledError> {
        if (this.is_cancelled()) {
            return Result.Err(CancelledError.cancelled());
        }
        return Result.Ok(true);
    }
}

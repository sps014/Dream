module system.core;

// Mathematical functions. Trig and most transcendentals are host-native (`env.*`);
// thin public wrappers expose them (Dream forbids `public` + `extern` on one symbol).
public class Math {
    @js("env", "abs")
    static extern fun abs_host(x: double): double;
    public static fun abs(x: double): double { return Math.abs_host(x); }

    @js("env", "floor")
    static extern fun floor_host(x: double): double;
    public static fun floor(x: double): double { return Math.floor_host(x); }

    @js("env", "ceil")
    static extern fun ceil_host(x: double): double;
    public static fun ceil(x: double): double { return Math.ceil_host(x); }

    @js("env", "round")
    static extern fun round_host(x: double): double;
    public static fun round(x: double): double { return Math.round_host(x); }

    @js("env", "sqrt")
    static extern fun sqrt_host(x: double): double;

    // Returns the square root of `x` or None.
    public static fun sqrt(x: double): Option<double> {
        if (x < 0.0d) {
            return Option.None;
        }
        return Option.Some(Math.sqrt_host(x));
    }

    @js("env", "pow")
    static extern fun pow_host(base: double, exponent: double): double;
    public static fun pow(base: double, exponent: double): double {
        return Math.pow_host(base, exponent);
    }

    @js("env", "sin")
    static extern fun sin_host(x: double): double;
    public static fun sin(x: double): double { return Math.sin_host(x); }

    @js("env", "cos")
    static extern fun cos_host(x: double): double;
    public static fun cos(x: double): double { return Math.cos_host(x); }

    @js("env", "tan")
    static extern fun tan_host(x: double): double;
    public static fun tan(x: double): double { return Math.tan_host(x); }

    @js("env", "asin")
    static extern fun asin_host(x: double): double;
    public static fun asin(x: double): double { return Math.asin_host(x); }

    @js("env", "acos")
    static extern fun acos_host(x: double): double;
    public static fun acos(x: double): double { return Math.acos_host(x); }

    @js("env", "atan")
    static extern fun atan_host(x: double): double;
    public static fun atan(x: double): double { return Math.atan_host(x); }

    @js("env", "atan2")
    static extern fun atan2_host(y: double, x: double): double;
    public static fun atan2(y: double, x: double): double {
        return Math.atan2_host(y, x);
    }
}

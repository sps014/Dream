module system.core;

// `Result<T, E>` - the outcome of an operation that may fail.
public enum Result<T, E> {
    Ok(value: T),
    Err(error: E),

    // True when this is `Ok`.
    public fun is_ok(): bool {
        return switch (this) {
            Ok(v)  => true,
            Err(e) => false,
        };
    }

    // True when this is `Err`.
    public fun is_err(): bool {
        return switch (this) {
            Ok(v)  => false,
            Err(e) => true,
        };
    }

    // The success value when `Ok`, otherwise `fallback`.
    public fun unwrap_or(fallback: T): T {
        return switch (this) {
            Ok(v)  => v,
            Err(e) => fallback,
        };
    }

    // Maps the success value when `Ok`, otherwise preserves the error.
    public fun map<U>(f: fun(T): U): Result<U, E> {
        return switch (this) {
            Ok(v)  => Result.Ok(f(v)),
            Err(e) => Result.Err(e),
        };
    }

    // Maps the error when `Err`, otherwise preserves the success value.
    public fun map_err<F>(f: fun(E): F): Result<T, F> {
        return switch (this) {
            Ok(v)  => Result.Ok(v),
            Err(e) => Result.Err(f(e)),
        };
    }

    // Chains into another `Result` when `Ok`, otherwise preserves the error.
    public fun and_then<U>(f: fun(T): Result<U, E>): Result<U, E> {
        return switch (this) {
            Ok(v)  => f(v),
            Err(e) => Result.Err(e),
        };
    }
}

module system.core;

// Primitive (and string) arrays implement `IndexedCollection` so they upcast to
// `Collection`/`IndexedCollection` and share query defaults. Element types beyond this set still
// need `List.from_array` until generic `extend T[]` exists.
// `this.size()` inside these methods resolves to the builtin `ArrayLen` (checked before instance
// dispatch), so the interface `size` slot does not recurse.

extend int[] : IndexedCollection<int> {
    public fun size(): int {
        return this.size();
    }

    @get
    public fun get(index: int): Option<int> {
        if (index < 0 || index >= this.size()) {
            return Option.None;
        }
        return Option.Some(this[index]);
    }

    @iterator
    public fun iterator(): Iterator<int> {
        return ArrayIterator<int>(this);
    }
}


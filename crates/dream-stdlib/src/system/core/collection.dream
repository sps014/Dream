module system.core;

// Pull one element at a time. Concrete iterators (`ListIterator`, …) implement this.
// `@next` lives on the implementing class (attributes are not required on the interface).
public interface Iterator<T> {
    fun next(): Option<T>;
}

// Sized collection — the type users pass into APIs that need a count.
// `for (let x in xs)` still requires a concrete type with `@iterator`; through this interface,
// call `.iterator()` and drive `.next()` explicitly (or accept a concrete `List`/`Set`/`Map`).
public interface Collection<T> {
    fun size(): int;

    fun iterator(): Iterator<T>;

    public fun is_empty(): bool {
        return this.size() == 0;
    }
}

// Ordered, indexable sequences (`List`).
public interface IndexedCollection<T> {
    fun size(): int;

    fun iterator(): Iterator<T>;

    @get
    fun get(index: int): Option<T>;

    public fun is_empty(): bool {
        return this.size() == 0;
    }

    public fun first(): Option<T> {
        return this.get(0);
    }

    public fun last(): Option<T> {
        return this.get(this.size() - 1);
    }
}

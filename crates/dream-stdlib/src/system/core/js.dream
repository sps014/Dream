module system.core;

// `js` - the dynamic JavaScript-interop type.
//
// A `js` value is an opaque handle to a live JavaScript value held by the runtime (see
// `runtime/dream.js`). Member access, method calls, indexing, and calling a `js` value all bind
// *dynamically* at runtime - the compiler performs no member resolution, so `doc.getElementById("app")`
// or `el.title = "x"` compile as-is and are dispatched by the JS host. Every dynamic operation
// yields another `js`; convert back to a Dream value at a typed boundary (e.g. `let n: int = el.x`)
// or with the explicit `.to_int()` / `.to_str()` / ... helpers below.
//
// The compiler desugars dynamic operations into the host bridges declared here, marshaling
// arguments through a single host call. These bridges are an implementation detail; user code uses
// native syntax.

extend js {
    // --- entry points ----------------------------------------------------------------------

    // A handle to a value on the JS global scope by name (e.g. `js.global("document")`), for
    // computed names. Prefer the property form `js.global.document` / `js.global.fetch(...)`, which
    // binds `js.global` to `globalThis` (see `global_this`) and then reads members dynamically.
    @js("Dream", "jsGlobal")
    static extern fun global(name: string): js;
    // `globalThis` itself, backing the `js.global.<member>` property syntax.
    @js("Dream", "jsGlobalThis")
    static extern fun global_this(): js;
    // A fresh empty JS object (`{}`) to populate and hand to a JS API.
    @js("Dream", "jsObject")
    static extern fun object(): js;
    // A fresh empty JS array (`[]`).
    @js("Dream", "jsArray")
    static extern fun array(): js;

    // Wraps a Dream function as a JS callable (e.g. an event handler). The wrapper has stable
    // identity per function, so a handler registered with `addEventListener` can be removed with
    // `removeEventListener`. A one-argument handler receives the JS argument (e.g. the event) as a
    // `js`. Passing a bare `fun(js): void` / `fun(): void` to a dynamic `js` call auto-wraps it, so
    // `el.addEventListener("click", onClick)` also works directly.
    @js("Dream", "jsFunc")
    static extern fun func(handler: fun(js): void): js;
    @js("Dream", "jsFunc0")
    static extern fun func0(handler: fun(): void): js;
    // Generalized boxing for a handler of any arity (two or more `js` parameters, e.g. a
    // `(value, index)` iteratee or an `(a, b, c)` reducer). The compiler passes the raw funcref-table
    // index and the parameter count; the host wraps it as `fun(js, …): void`. A bare
    // `fun(js, js, …): void` passed to a dynamic `js` call auto-wraps through here.
    @js("Dream", "jsFuncN")
    static extern fun funcN(index: int, arity: int): js;

    // --- boxing: Dream value -> js handle (used by the compiler when marshaling arguments) ---
    @js("Dream", "jsInt")
    static extern fun box_int(value: int): js;
    @js("Dream", "jsLong")
    static extern fun box_long(value: long): js;
    @js("Dream", "jsDouble")
    static extern fun box_double(value: double): js;
    @js("Dream", "jsBool")
    static extern fun box_bool(value: bool): js;
    @js("Dream", "jsString")
    static extern fun box_string(value: string): js;

    // --- dynamic operations (variadic call/invoke args are carried in a `js[]`) --------------
    @js("Dream", "jsGetV")
    static extern fun get(target: js, name: string): js;
    @js("Dream", "jsSetV")
    static extern fun set(target: js, name: string, value: js): void;
    // Property write with one shadow-stack value slot (no pre-box bridge for primitives/string).
    @js("Dream", "jsSetSlot")
    static extern fun set_slot(target: js, name: string, args_ptr: int, argc: int): void;
    // Variadic call/invoke. The compiler does not call these with a Dream argument list: it emits a
    // shadow-stack buffer of tagged 16-byte slots and passes its pointer + count, so all arguments
    // cross in a single boundary crossing with no per-argument boxing or heap array. The `args_ptr`
    // / `argc` parameters describe that buffer.
    @js("Dream", "jsCallV")
    static extern fun call(target: js, name: string, args_ptr: int, argc: int): js;
    @js("Dream", "jsInvokeV")
    static extern fun invoke(target: js, args_ptr: int, argc: int): js;
    // `target[prop][method](...args)` in one crossing (fused get + call).
    @js("Dream", "jsGetCallV")
    static extern fun get_call(target: js, prop: string, method: string, args_ptr: int, argc: int): js;
    @js("Dream", "jsIndexGetV")
    static extern fun index_get(target: js, key: js): js;
    @js("Dream", "jsIndexSetV")
    static extern fun index_set(target: js, key: js, value: js): void;
    // Index write with key+value in two shadow-stack slots (no per-value boxing bridges).
    @js("Dream", "jsIndexSetSlot")
    static extern fun index_set_slot(target: js, args_ptr: int, argc: int): void;

    // Typed-boundary fusion: property get that returns a Dream primitive/string directly (no
    // intermediate `js` handle). Used when `let x: T = recv.name` would otherwise be get + as_*.
    @js("Dream", "jsGetAsInt")
    static extern fun get_as_int(target: js, name: string): int;
    @js("Dream", "jsGetAsLong")
    static extern fun get_as_long(target: js, name: string): long;
    @js("Dream", "jsGetAsDouble")
    static extern fun get_as_double(target: js, name: string): double;
    @js("Dream", "jsGetAsBool")
    static extern fun get_as_bool(target: js, name: string): bool;
    @js("Dream", "jsGetAsString")
    static extern fun get_as_string(target: js, name: string): string;

    // Typed-boundary fusion: method call / invoke that returns a Dream primitive/string directly.
    @js("Dream", "jsCallAsInt")
    static extern fun call_as_int(target: js, name: string, args_ptr: int, argc: int): int;
    @js("Dream", "jsCallAsLong")
    static extern fun call_as_long(target: js, name: string, args_ptr: int, argc: int): long;
    @js("Dream", "jsCallAsDouble")
    static extern fun call_as_double(target: js, name: string, args_ptr: int, argc: int): double;
    @js("Dream", "jsCallAsBool")
    static extern fun call_as_bool(target: js, name: string, args_ptr: int, argc: int): bool;
    @js("Dream", "jsCallAsString")
    static extern fun call_as_string(target: js, name: string, args_ptr: int, argc: int): string;
    @js("Dream", "jsInvokeAsInt")
    static extern fun invoke_as_int(target: js, args_ptr: int, argc: int): int;
    @js("Dream", "jsInvokeAsLong")
    static extern fun invoke_as_long(target: js, args_ptr: int, argc: int): long;
    @js("Dream", "jsInvokeAsDouble")
    static extern fun invoke_as_double(target: js, args_ptr: int, argc: int): double;
    @js("Dream", "jsInvokeAsBool")
    static extern fun invoke_as_bool(target: js, args_ptr: int, argc: int): bool;
    @js("Dream", "jsInvokeAsString")
    static extern fun invoke_as_string(target: js, args_ptr: int, argc: int): string;

    // Fused get + call + typed unbox.
    @js("Dream", "jsGetCallAsInt")
    static extern fun get_call_as_int(target: js, prop: string, method: string, args_ptr: int, argc: int): int;
    @js("Dream", "jsGetCallAsLong")
    static extern fun get_call_as_long(target: js, prop: string, method: string, args_ptr: int, argc: int): long;
    @js("Dream", "jsGetCallAsDouble")
    static extern fun get_call_as_double(target: js, prop: string, method: string, args_ptr: int, argc: int): double;
    @js("Dream", "jsGetCallAsBool")
    static extern fun get_call_as_bool(target: js, prop: string, method: string, args_ptr: int, argc: int): bool;
    @js("Dream", "jsGetCallAsString")
    static extern fun get_call_as_string(target: js, prop: string, method: string, args_ptr: int, argc: int): string;

    // Awaits a JS thenable/Promise handle, yielding the resolved value as another `js`, or a `null`
    // `js` if the Promise rejected (the reason is logged host-side). Bridged as `extern async` so it
    // flows through the same Future machinery as any other async call.
    @js("Dream", "jsAwait")
    static extern async fun await_raw(target: js): js;

    // The awaited result the compiler actually targets: `await <jsExpr>` desugars to
    // `await js.await_promise(<jsExpr>)`, which yields `Option<js>` - `Some(value)` when the Promise
    // resolved, `None` when it rejected (or resolved with `null`/`undefined`). So a JS Promise reads
    // natively while still forcing the caller to handle failure:
    //   let r = await js.global.fetch("/api");   // r: Option<js>
    static async fun await_promise(target: js): Option<js> {
        let v = await js.await_raw(target);
        if (v.is_null()) {
            return Option.None;
        }
        return Option.Some(v);
    }

    // --- unboxing: js handle -> Dream value (used by the compiler + the helpers below) -------
    @js("Dream", "jsAsInt")
    static extern fun as_int(target: js): int;
    @js("Dream", "jsAsLong")
    static extern fun as_long(target: js): long;
    @js("Dream", "jsAsDouble")
    static extern fun as_double(target: js): double;
    @js("Dream", "jsAsBool")
    static extern fun as_bool(target: js): bool;
    @js("Dream", "jsAsString")
    static extern fun as_string(target: js): string;
    @js("Dream", "jsIsNull")
    static extern fun host_is_null(target: js): bool;
    @js("Dream", "jsRelease")
    static extern fun host_release(target: js): void;

    // --- ergonomic instance API (resolved before dynamic dispatch, so these names are safe) --

    // Explicit conversions back to Dream values.
    public fun to_int(): int {
        return js.as_int(this);
    }
    public fun to_double(): double {
        return js.as_double(this);
    }
    public fun to_bool(): bool {
        return js.as_bool(this);
    }
    public fun to_str(): string {
        return js.as_string(this);
    }

    // True if the referenced value is `null` or `undefined`.
    public fun is_null(): bool {
        return js.host_is_null(this);
    }

    // Releases the host-side handle. Use for long-lived references to avoid leaking them.
    public fun release(): void {
        js.host_release(this);
    }
}

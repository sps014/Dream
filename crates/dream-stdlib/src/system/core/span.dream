module system.core;

// `Span<T>` - a bounds-checked, non-owning view over a contiguous run of an existing `T[]`'s
// elements. It is a `ref struct` (see `docs/language/classes-structs.md`): stored inline, copied by
// value, with zero heap allocation of its own, and rejected by the compiler anywhere it could
// escape the stack frame that created it (a class/struct field, a generic type argument, a lambda
// capture, or an `async` parameter).
//
// Unlike a raw pointer, a `Span<T>` keeps its backing array field (`array`) strongly referenced, so
// the memory it views can never be freed out from under it — slicing/indexing only needs its own
// logical-range check, never an "is this memory still alive" check.
public ref struct Span<T> {
    array: T[];
    // Index into `array` of this span's first element.
    offset: int;
    _length: int;

    public constructor(array: T[], offset: int, length: int) {
        this.array = array;
        this.offset = offset;
        this._length = length;
    }

    // A span over the whole of `array`.
    public static fun of(array: T[]): Span<T> {
        return Span<T>(array, 0, array.length);
    }

    // Number of elements this span covers.
    public get length(): int {
        return this._length;
    }

    // True when this span covers no elements.
    public fun is_empty(): bool {
        return this._length == 0;
    }

    // The element at `index` (relative to this span, not the backing array). Traps if out of range.
    @get_indexer
    public fun get(index: int): T {
        if ((index < 0) || (index >= this._length)) {
            System.panic("Span index out of range");
        }
        return this.array[this.offset + index];
    }

    // Overwrites the element at `index` (relative to this span). Traps if out of range.
    @set_indexer
    public fun set(index: int, value: T): void {
        if ((index < 0) || (index >= this._length)) {
            System.panic("Span index out of range");
        }
        this.array[this.offset + index] = value;
    }

    // A sub-span covering `[start, start + count)` of this span's own range. Traps if the requested
    // range doesn't fit within this span.
    public fun slice(start: int, count: int): Span<T> {
        if ((start < 0) || (count < 0) || (start + count > this._length)) {
            System.panic("Span slice out of range");
        }
        return Span<T>(this.array, this.offset + start, count);
    }

    // Copies every element of `src` into this span starting at index 0. Traps if `src` is longer
    // than this span.
    public fun copy_from(src: Span<T>): void {
        if (src._length > this._length) {
            System.panic("Span copy_from overflow");
        }
        let i = 0;
        while (i < src._length) {
            this.array[this.offset + i] = src.array[src.offset + i];
            i = i + 1;
        }
    }

    // Fills every element of this span with `value`.
    public fun fill(value: T): void {
        let i = 0;
        while (i < this._length) {
            this.array[this.offset + i] = value;
            i = i + 1;
        }
    }

    // Copies every element of this span into a fresh, independently-owned array.
    public fun to_array(): T[] {
        let result = Buffer.alloc<T>(this._length);
        let i = 0;
        while (i < this._length) {
            result[i] = this.array[this.offset + i];
            i = i + 1;
        }
        return result;
    }
}

module system.json;

// Snapshot model for the `@json` source generator. The compile host fills these from the
// declaration SemanticModel and passes them to [`JsonGenerator`].

public class GenField {
    public name: string;
    public type_name: string;
    public json_ignore: bool;
    public property_name: string;
    public option_inner: string;
    public is_type_param: bool;

    constructor(
        name: string,
        type_name: string,
        json_ignore: bool,
        property_name: string,
        option_inner: string,
        is_type_param: bool
    ) {
        this.name = name;
        this.type_name = type_name;
        this.json_ignore = json_ignore;
        this.property_name = property_name;
        this.option_inner = option_inner;
        this.is_type_param = is_type_param;
    }

    public static fun make(
        name: string,
        type_name: string,
        json_ignore: bool,
        property_name: string,
        option_inner: string,
        is_type_param: bool
    ): GenField {
        return GenField(name, type_name, json_ignore, property_name, option_inner, is_type_param);
    }

    public fun json_key(): string {
        if (this.property_name.size() > 0) {
            return this.property_name;
        }
        return this.name;
    }
}

public class GenVariant {
    public name: string;
    public fields: List<GenField>;

    constructor(name: string, fields: List<GenField>) {
        this.name = name;
        this.fields = fields;
    }

    public static fun make(name: string, fields: List<GenField>): GenVariant {
        return GenVariant(name, fields);
    }
}

public class GenType {
    public name: string;
    public is_union: bool;
    public generic_params: List<string>;
    public fields: List<GenField>;
    public variants: List<GenVariant>;

    constructor(
        name: string,
        is_union: bool,
        generic_params: List<string>,
        fields: List<GenField>,
        variants: List<GenVariant>
    ) {
        this.name = name;
        this.is_union = is_union;
        this.generic_params = generic_params;
        this.fields = fields;
        this.variants = variants;
    }

    public static fun class_type(
        name: string,
        generic_params: List<string>,
        fields: List<GenField>
    ): GenType {
        return GenType(name, false, generic_params, fields, List<GenVariant>());
    }

    public static fun union_type(
        name: string,
        generic_params: List<string>,
        variants: List<GenVariant>
    ): GenType {
        return GenType(name, true, generic_params, List<GenField>(), variants);
    }

    public fun params_clause(): string {
        if (this.generic_params.is_empty()) {
            return "";
        }
        let s = "<";
        let i = 0;
        while (i < this.generic_params.size()) {
            if (i > 0) {
                s = s + ", ";
            }
            s = s + this.generic_params.get(i).unwrap_or("");
            i = i + 1;
        }
        return s + ">";
    }

    public fun self_ty(): string {
        return this.name + this.params_clause();
    }
}

public class GenResult {
    public ok: bool;
    public source: string;
    public error: string;

    constructor(ok: bool, source: string, error: string) {
        this.ok = ok;
        this.source = source;
        this.error = error;
    }

    public static fun success(source: string): GenResult {
        return GenResult(true, source, "");
    }

    public static fun failure(error: string): GenResult {
        return GenResult(false, "", error);
    }
}

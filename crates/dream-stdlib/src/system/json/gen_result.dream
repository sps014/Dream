module system.json;

// Outcome of a `@json` source-generator expand pass.
// Optional `error_type` / `error_field` let the host attach a source span when reporting
// `DiagnosticBag` errors (see `driver/generate/json_gen.rs`).
public class GenResult {
    public ok: bool;
    public source: string;
    public error: string;
    public error_type: string;
    public error_field: string;

    // Builds a raw result; prefer `success` / `failure` / `failure_at`.
    public constructor(ok: bool, source: string, error: string, error_type: string, error_field: string) {
        this.ok = ok;
        this.source = source;
        this.error = error;
        this.error_type = error_type;
        this.error_field = error_field;
    }

    // Successful expand with emitted Dream source.
    public static fun success(source: string): GenResult {
        return GenResult(true, source, "", "", "");
    }

    // Failed expand with a diagnostic message (no span hint).
    public static fun failure(error: string): GenResult {
        return GenResult(false, "", error, "", "");
    }

    // Failed expand with type/field names for host span recovery.
    public static fun failure_at(error: string, type_name: string, field_name: string): GenResult {
        return GenResult(false, "", error, type_name, field_name);
    }
}

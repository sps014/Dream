module system.json;

// Outcome of a `@json` source-generator expand pass.
public class GenResult {
    public ok: bool;
    public source: string;
    public error: string;

    // Builds a raw result; prefer `success` / `failure`.
    public constructor(ok: bool, source: string, error: string) {
        this.ok = ok;
        this.source = source;
        this.error = error;
    }

    // Successful expand with emitted Dream source.
    public static fun success(source: string): GenResult {
        return GenResult(true, source, "");
    }

    // Failed expand with a diagnostic message.
    public static fun failure(error: string): GenResult {
        return GenResult(false, "", error);
    }
}

module system.json;

// The public JSON API.

public class Json {
    @intrinsic("json_serialize")
    static extern fun serialize<T>(value: T): string;

    @intrinsic("json_deserialize")
    static extern fun deserialize<T>(text: string): Result<T, ParseError>;

    // Reconstruct a `@json` value from an already-parsed `JsonValue` (no parse step).
    @intrinsic("json_from_value")
    static extern fun from_value<T>(value: JsonValue): T;

    // Compact stringify of a dynamic `JsonValue` tree.
    public static fun stringify(value: JsonValue): string {
        let sb = StringBuilder();
        Json._json_stringify_into(sb, value);
        return sb.build();
    }

    // Pretty-prints `value` with newlines and `indent` spaces per nesting level (e.g. 2 or 4).
    // Pass 0 to fall back to compact output.
    public static fun stringify_pretty(value: JsonValue, indent: int): string {
        if (indent <= 0) {
            return Json.stringify(value);
        }
        let sb = StringBuilder();
        Json._json_stringify_pretty_into(sb, value, indent, 0);
        return sb.build();
    }

    // Parses `text` into a dynamic `JsonValue` tree.
    public static fun parse(text: string): Result<JsonValue, ParseError> {
        if (text.is_empty()) {
            return Result.Err(ParseError.invalid("empty JSON input"));
        }
        let parser = JsonParser(text, 0, text.length);
        let value = parser.parse_value();
        if (parser.at_end() == false) {
            return Result.Err(ParseError.invalid("trailing characters after JSON value"));
        }
        return Result.Ok(value);
    }


    // --- internal serialization helpers -----------------------------------------------------

    // Appends a quoted, escaped JSON string to `sb`.
    static fun _json_escape_into(sb: StringBuilder, s: string): void {
        sb.append_char('"');
        let n = s.length;
        let i = 0;
        while (i < n) {
            let c = s.char_at(i);
            if (c == '"') {
                sb.append_char('\\');
                sb.append_char('"');
            } else if (c == '\\') {
                sb.append_char('\\');
                sb.append_char('\\');
            } else if (c == '\n') {
                sb.append_char('\\');
                sb.append_char('n');
            } else if (c == '\t') {
                sb.append_char('\\');
                sb.append_char('t');
            } else if (c == '\r') {
                sb.append_char('\\');
                sb.append_char('r');
            } else {
                sb.append_char(c);
            }
            i = i + 1;
        }
        sb.append_char('"');
    }

    // Formats a JSON number: integral values print without a decimal point, others fall back to the
    // default double formatting.
    static fun _json_number(n: double): string {
        let i = (int)n;
        if ((double)i == n) {
            return i.to_string();
        }
        return n.to_string();
    }

    // Recursively serializes a JsonValue into `sb` as compact JSON text.
    static fun _json_stringify_into(sb: StringBuilder, v: JsonValue): void {
        let k = v.kind;
        if (k == 0) {
            sb.append("null");
            return;
        }
        if (k == 1) {
            if (v.bool_val == true) {
                sb.append("true");
            } else {
                sb.append("false");
            }
            return;
        }
        if (k == 2) {
            sb.append(Json._json_number(v.num_val));
            return;
        }
        if (k == 3) {
            Json._json_escape_into(sb, v.str_val);
            return;
        }
        if (k == 4) {
            sb.append_char('[');
            let i = 0;
            while (i < v.items.length) {
                if (i > 0) {
                    sb.append_char(',');
                }
                Json._json_stringify_into(sb, v.items.get(i).unwrap_or(JsonValue.none()));
                i = i + 1;
            }
            sb.append_char(']');
            return;
        }
        if (k == 5) {
            sb.append_char('{');
            let i = 0;
            while (i < v.obj_keys.length) {
                if (i > 0) {
                    sb.append_char(',');
                }
                let key = v.obj_keys.get(i).unwrap_or("");
                Json._json_escape_into(sb, key);
                sb.append_char(':');
                Json._json_stringify_into(sb, v.get(key).unwrap_or(JsonValue.none()));
                i = i + 1;
            }
            sb.append_char('}');
            return;
        }
        sb.append("null");
    }

    // Appends `n` spaces to `sb`.
    static fun _json_spaces_into(sb: StringBuilder, n: int): void {
        let i = 0;
        while (i < n) {
            sb.append_char(' ');
            i = i + 1;
        }
    }

    // Recursively serializes a JsonValue with newlines and `indent` spaces of nesting per level.
    static fun _json_stringify_pretty_into(sb: StringBuilder, v: JsonValue, indent: int, depth: int): void {
        let k = v.kind;
        if (k == 4) {
            if (v.items.length == 0) {
                sb.append("[]");
                return;
            }
            sb.append("[\n");
            let i = 0;
            while (i < v.items.length) {
                if (i > 0) {
                    sb.append(",\n");
                }
                Json._json_spaces_into(sb, indent * (depth + 1));
                Json._json_stringify_pretty_into(sb, v.items.get(i).unwrap_or(JsonValue.none()), indent, depth + 1);
                i = i + 1;
            }
            sb.append_char('\n');
            Json._json_spaces_into(sb, indent * depth);
            sb.append_char(']');
            return;
        }
        if (k == 5) {
            if (v.obj_keys.length == 0) {
                sb.append("{}");
                return;
            }
            sb.append("{\n");
            let i = 0;
            while (i < v.obj_keys.length) {
                if (i > 0) {
                    sb.append(",\n");
                }
                Json._json_spaces_into(sb, indent * (depth + 1));
                let key = v.obj_keys.get(i).unwrap_or("");
                Json._json_escape_into(sb, key);
                sb.append(": ");
                Json._json_stringify_pretty_into(sb, v.get(key).unwrap_or(JsonValue.none()), indent, depth + 1);
                i = i + 1;
            }
            sb.append_char('\n');
            Json._json_spaces_into(sb, indent * depth);
            sb.append_char('}');
            return;
        }
        Json._json_stringify_into(sb, v);
    }
}

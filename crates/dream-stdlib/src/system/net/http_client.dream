module system.net;

// A cross-runtime HTTP client returning `Result<HttpResponse, HttpError>`.
public class HttpClient {
    base_url: string;
    default_headers: HttpHeaders;
    // Request timeout in milliseconds; `0` means no timeout.
    public timeout_ms: int;
    cookie_jar: Option<CookieJar>;
    cancel_token: Option<CancellationToken>;

    @js("Dream", "httpRequest")
    static extern async fun http_request(url: string, method: string, headers: string, body: string, timeout_ms: int): char[];

    @js("Dream", "httpRequestBytes")
    static extern async fun http_request_bytes(url: string, method: string, headers: string, body: byte[], timeout_ms: int): char[];

    // Creates an HTTP client with a base URL.
    public constructor(base_url: string) {
        this.base_url = base_url;
        this.default_headers = HttpHeaders();
        this.timeout_ms = 0;
        this.cookie_jar = Option.None;
        this.cancel_token = Option.None;
    }

    // Sets the request timeout in milliseconds (`0` = none).
    public fun with_timeout(ms: int): HttpClient {
        this.timeout_ms = ms;
        return this;
    }

    // Attaches a cookie jar used for outbound `Cookie` and inbound `Set-Cookie`.
    public fun with_cookie_jar(jar: CookieJar): HttpClient {
        this.cookie_jar = Option.Some(jar);
        return this;
    }

    // Attaches a cooperative cancellation token checked before each request.
    public fun with_cancellation(token: CancellationToken): HttpClient {
        this.cancel_token = Option.Some(token);
        return this;
    }

    // Adds a default header sent with every request.
    public fun set_header(name: string, value: string): HttpClient {
        this.default_headers.set(name, value);
        return this;
    }

    fun resolve(path: string): string {
        if (this.base_url.is_empty() == true) {
            return path;
        }
        if (path.starts_with("http") == true) {
            return path;
        }
        return this.base_url + path;
    }

    fun merge_headers(call: HttpHeaders): string {
        let merged = HttpHeaders();
        for (let pair in this.default_headers) {
            merged.set(pair.key, pair.value);
        }
        for (let pair in call) {
            merged.set(pair.key, pair.value);
        }
        switch (this.cookie_jar) {
            Some(jar) => {
                let cookie = jar.to_header();
                if (cookie.is_empty() == false) {
                    merged.set("Cookie", cookie);
                }
            },
            None => { },
        }
        return merged.to_wire();
    }

    fun wrap(raw: char[]): Result<HttpResponse, HttpError> {
        let res = HttpResponse(raw);
        if (res.status() == 0) {
            return Result.Err(HttpError.transport(res.text()));
        }
        switch (this.cookie_jar) {
            Some(jar) => { jar.store_from_response(res); },
            None => { },
        }
        return Result.Ok(res);
    }

    // Performs a request with a text body.
    public async fun request(method: string, path: string, body: string, headers: HttpHeaders): Result<HttpResponse, HttpError> {
        switch (this.cancel_token) {
            Some(tok) => {
                if (tok.is_cancelled()) {
                    return Result.Err(HttpError.transport("cancelled"));
                }
            },
            None => { },
        }
        let raw = await HttpClient.http_request(this.resolve(path), method, this.merge_headers(headers), body, this.timeout_ms);
        return this.wrap(raw);
    }

    // Performs a GET request.
    public async fun get(path: string): Result<HttpResponse, HttpError> {
        return await this.request("GET", path, "", HttpHeaders());
    }

    // Performs a POST request.
    public async fun post(path: string, body: string): Result<HttpResponse, HttpError> {
        return await this.request("POST", path, body, HttpHeaders());
    }

    // Performs a PUT request.
    public async fun put(path: string, body: string): Result<HttpResponse, HttpError> {
        return await this.request("PUT", path, body, HttpHeaders());
    }

    // Performs a PATCH request.
    public async fun patch(path: string, body: string): Result<HttpResponse, HttpError> {
        return await this.request("PATCH", path, body, HttpHeaders());
    }

    // Performs a DELETE request.
    public async fun delete(path: string): Result<HttpResponse, HttpError> {
        return await this.request("DELETE", path, "", HttpHeaders());
    }

    // Performs a HEAD request.
    public async fun head(path: string): Result<HttpResponse, HttpError> {
        return await this.request("HEAD", path, "", HttpHeaders());
    }

    // Performs a GET request and resolves with its body as text.
    public async fun text(path: string): Result<string, HttpError> {
        return switch (await this.get(path)) {
            Ok(res) => Result.Ok(res.text()),
            Err(e) => Result.Err(e),
        };
    }

    // Performs a request with a binary body.
    public async fun request_bytes(method: string, path: string, body: byte[], headers: HttpHeaders): Result<HttpResponse, HttpError> {
        switch (this.cancel_token) {
            Some(tok) => {
                if (tok.is_cancelled()) {
                    return Result.Err(HttpError.transport("cancelled"));
                }
            },
            None => { },
        }
        let raw = await HttpClient.http_request_bytes(this.resolve(path), method, this.merge_headers(headers), body, this.timeout_ms);
        return this.wrap(raw);
    }

    // Performs a POST request with a binary body.
    public async fun post_bytes(path: string, body: byte[]): Result<HttpResponse, HttpError> {
        return await this.request_bytes("POST", path, body, HttpHeaders());
    }

    // Performs a PUT request with a binary body.
    public async fun put_bytes(path: string, body: byte[]): Result<HttpResponse, HttpError> {
        return await this.request_bytes("PUT", path, body, HttpHeaders());
    }

    // POSTs a multipart form via `request_bytes`.
    public async fun post_multipart(path: string, form: MultipartForm): Result<HttpResponse, HttpError> {
        let built = form.build();
        return await this.request_bytes("POST", path, built.body, built.headers);
    }
}

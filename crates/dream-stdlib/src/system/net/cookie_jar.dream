module system.net;

// In-memory cookie store for `HttpClient` (no OS cookie jar).
public class CookieJar {
    names: List<string>;
    values: List<string>;
    index: Map<string, int>;

    // Creates an empty jar.
    public constructor() {
        this.names = List<string>();
        this.values = List<string>();
        this.index = Map<string, int>();
    }

    // Stores or overwrites cookie `name`.
    public fun set(name: string, value: string): void {
        let existing = this.index.get(name);
        if (existing.is_some()) {
            this.values.set(existing.unwrap_or(0), value);
        } else {
            this.index.set(name, this.names.length);
            this.names.push(name);
            this.values.push(value);
        }
    }

    // Value for `name`, or `None` when absent.
    public fun get(name: string): Option<string> {
        let existing = this.index.get(name);
        if (existing.is_some()) {
            return this.values.get(existing.unwrap_or(0));
        }
        let none: Option<string> = Option.None;
        return none;
    }

    // Removes every cookie.
    public fun clear(): void {
        this.names.clear();
        this.values.clear();
        this.index.clear();
    }

    // Number of stored cookies.
    public get length(): int {
        return this.names.length;
    }

    // Builds a `Cookie` request header value (`name=value; …`).
    public fun to_header(): string {
        let sb = StringBuilder();
        let i = 0;
        while (i < this.names.length) {
            if (i > 0) {
                sb.append("; ");
            }
            sb.append(this.names.get(i).unwrap_or(""));
            sb.append_char('=');
            sb.append(this.values.get(i).unwrap_or(""));
            i = i + 1;
        }
        return sb.build();
    }

    // Parses `Set-Cookie` lines from an HTTP response into this jar.
    public fun store_from_response(res: HttpResponse): void {
        let head = res.head_text_for_cookies();
        let lines = head.split('\n');
        let i = 0;
        while (i < lines.length) {
            let line = lines[i];
            let lower = line.to_lower();
            if (lower.starts_with("set-cookie:")) {
                let rest = line.substring(11, line.length).trim();
                let semi = rest.index_of(';').unwrap_or(rest.length);
                let pair = rest.substring(0, semi);
                let eq = pair.index_of('=').unwrap_or(0 - 1);
                if (eq > 0) {
                    let name = pair.substring(0, eq).trim();
                    let value = pair.substring(eq + 1, pair.length).trim();
                    this.set(name, value);
                }
            }
            i = i + 1;
        }
    }
}

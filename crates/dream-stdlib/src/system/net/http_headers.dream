module system.net;

// Typed HTTP header map (replaces JSON-string headers).
public class HttpHeaders : Collection<KeyValuePair<string, string>> {
    keys: List<string>;
    values: List<string>;

    // Creates an empty header map.
    constructor() {
        this.keys = List<string>();
        this.values = List<string>();
    }

    // Sets header `name` to `value`, overwriting any existing entry (case-insensitive name match).
    public fun set(name: string, value: string): void {
        let i = this._find(name);
        if (i >= 0) {
            this.values.set(i, value);
        } else {
            this.keys.push(name);
            this.values.push(value);
        }
    }

    // Value for `name`, or `None` when absent (case-insensitive).
    public fun get(name: string): Option<string> {
        let i = this._find(name);
        if (i >= 0) {
            return this.values.get(i);
        }
        return Option.None;
    }

    // True when a header named `name` is present (case-insensitive).
    public fun contains(name: string): bool {
        return this._find(name) >= 0;
    }

    // Removes `name` if present; returns whether a header was removed.
    public fun remove(name: string): bool {
        let i = this._find(name);
        if (i < 0) {
            return false;
        }
        this.keys.remove_at(i);
        this.values.remove_at(i);
        return true;
    }

    // Number of stored header pairs.
    public fun size(): int {
        return this.keys.size();
    }

    // Iterates `(name, value)` pairs in insertion order.
    @iterator
    public fun iterator(): ListIterator<KeyValuePair<string, string>> {
        let pairs = List<KeyValuePair<string, string>>();
        let i = 0;
        while (i < this.keys.size()) {
            pairs.push(KeyValuePair<string, string>(
                this.keys.get(i).unwrap_or(""),
                this.values.get(i).unwrap_or("")
            ));
            i = i + 1;
        }
        return pairs.iterator();
    }

    // Wire format for the host bridge (JSON object string).
    public fun to_wire(): string {
        let obj = JsonValue.dict();
        let i = 0;
        while (i < this.keys.size()) {
            obj.set(
                this.keys.get(i).unwrap_or(""),
                JsonValue.from_string(this.values.get(i).unwrap_or(""))
            );
            i = i + 1;
        }
        return JSON.stringify(obj);
    }

    // Rebuilds headers from the host bridge JSON object string.
    public static fun from_wire(text: string): HttpHeaders {
        let headers = HttpHeaders();
        if (text.is_empty()) {
            return headers;
        }
        let obj = JSON.parse(text);
        switch (obj) {
            Ok(v) => {
                let keys = v.keys();
                let i = 0;
                while (i < keys.size()) {
                    let key = keys.get(i).unwrap_or("");
                    headers.set(key, v.get(key).unwrap_or(JsonValue.none()).as_string().unwrap_or(""));
                    i = i + 1;
                }
            },
            Err(e) => { },
        }
        return headers;
    }

    fun _find(name: string): int {
        let want = name.to_lower();
        let i = 0;
        while (i < this.keys.size()) {
            if (this.keys.get(i).unwrap_or("").to_lower() == want) {
                return i;
            }
            i = i + 1;
        }
        return 0 - 1;
    }
}

module system.net;

// Typed HTTP header map (replaces JSON-string headers).
public class HttpHeaders : Collection<KeyValuePair<string, string>> {
    keys: List<string>;
    values: List<string>;
    // Lowercased name -> index into `keys`/`values`.
    index: Map<string, int>;

    // Creates an empty header map.
    public constructor() {
        this.keys = List<string>();
        this.values = List<string>();
        this.index = Map<string, int>();
    }

    // Sets header `name` to `value`, overwriting any existing entry (case-insensitive name match).
    public fun set(name: string, value: string): void {
        let lower = name.to_lower();
        let existing = this.index.get(lower);
        if (existing.is_some()) {
            let i = existing.unwrap_or(0);
            this.keys.set(i, name);
            this.values.set(i, value);
        } else {
            this.index.set(lower, this.keys.length);
            this.keys.push(name);
            this.values.push(value);
        }
    }

    // Value for `name`, or `None` when absent (case-insensitive).
    public fun get(name: string): Option<string> {
        let existing = this.index.get(name.to_lower());
        if (existing.is_some()) {
            return this.values.get(existing.unwrap_or(0));
        }
        let none: Option<string> = Option.None;
        return none;
    }

    // True when a header named `name` is present (case-insensitive).
    public fun contains(name: string): bool {
        return this.index.contains(name.to_lower());
    }

    // Removes `name` if present; returns whether a header was removed.
    public fun remove(name: string): bool {
        let lower = name.to_lower();
        let existing = this.index.get(lower);
        if (existing.is_none()) {
            return false;
        }
        let i = existing.unwrap_or(0);
        this.keys.remove_at(i);
        this.values.remove_at(i);
        this.index.clear();
        let j = 0;
        while (j < this.keys.length) {
            this.index.set(this.keys.get(j).unwrap_or("").to_lower(), j);
            j = j + 1;
        }
        return true;
    }

    // Number of stored header pairs.
    public get length(): int {
        return this.keys.length;
    }

    // Iterates `(name, value)` pairs in insertion order without snapshotting into a new list.
    @iterator
    public fun iterator(): HttpHeadersIterator {
        return HttpHeadersIterator(this);
    }

    // Wire format for the host bridge (JSON object string).
    public fun to_wire(): string {
        let obj = JsonValue.dict();
        let i = 0;
        while (i < this.keys.length) {
            obj.set(
                this.keys.get(i).unwrap_or(""),
                JsonValue.from_string(this.values.get(i).unwrap_or(""))
            );
            i = i + 1;
        }
        return Json.stringify(obj);
    }

    // Rebuilds headers from the host bridge JSON object string.
    public static fun from_wire(text: string): HttpHeaders {
        let headers = HttpHeaders();
        if (text.is_empty()) {
            return headers;
        }
        let obj = Json.parse(text);
        switch (obj) {
            Ok(v) => {
                let keys = v.keys();
                let i = 0;
                while (i < keys.length) {
                    let key = keys.get(i).unwrap_or("");
                    headers.set(key, v.get(key).unwrap_or(JsonValue.none()).as_string().unwrap_or(""));
                    i = i + 1;
                }
            },
            Err(e) => { },
        }
        return headers;
    }

    internal fun key_at(i: int): string {
        return this.keys.get(i).unwrap_or("");
    }

    internal fun value_at(i: int): string {
        return this.values.get(i).unwrap_or("");
    }
}

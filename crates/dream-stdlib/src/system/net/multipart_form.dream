module system.net;

// Builder for `multipart/form-data` request bodies.

public class MultipartForm {
    field_names: List<string>;
    field_values: List<string>;
    file_names: List<string>;
    file_filenames: List<string>;
    file_types: List<string>;
    file_bodies: List<byte[]>;

    // Creates an empty form.
    public constructor() {
        this.field_names = List<string>();
        this.field_values = List<string>();
        this.file_names = List<string>();
        this.file_filenames = List<string>();
        this.file_types = List<string>();
        this.file_bodies = List<byte[]>();
    }

    // Adds a text form field.
    public fun add_field(name: string, value: string): void {
        this.field_names.push(name);
        this.field_values.push(value);
    }

    // Adds a file part with raw `bytes`.
    public fun add_file(name: string, filename: string, content_type: string, bytes: byte[]): void {
        this.file_names.push(name);
        this.file_filenames.push(filename);
        this.file_types.push(content_type);
        this.file_bodies.push(bytes);
    }

    // Returns `(Content-Type headers, body bytes)` for `request_bytes`.
    public fun build(): MultipartBuilt {
        let boundary = "dreamform" + this.field_names.length.to_string() + "x" + this.file_names.length.to_string();
        let total = 0;
        let i = 0;
        while (i < this.field_names.length) {
            let name = this.field_names.get(i).unwrap_or("");
            let value = this.field_values.get(i).unwrap_or("");
            total = total + MultipartForm._str_bytes("--" + boundary + "\r\n");
            total = total + MultipartForm._str_bytes(
                "Content-Disposition: form-data; name=\"" + name + "\"\r\n\r\n"
            );
            total = total + MultipartForm._str_bytes(value);
            total = total + 2; // \r\n
            i = i + 1;
        }
        i = 0;
        while (i < this.file_names.length) {
            let name = this.file_names.get(i).unwrap_or("");
            let filename = this.file_filenames.get(i).unwrap_or("");
            let ctype = this.file_types.get(i).unwrap_or("application/octet-stream");
            let body = this.file_bodies.get(i).unwrap_or(Buffer.alloc<byte>(0));
            total = total + MultipartForm._str_bytes("--" + boundary + "\r\n");
            total = total + MultipartForm._str_bytes(
                "Content-Disposition: form-data; name=\"" + name + "\"; filename=\"" + filename + "\"\r\n"
            );
            total = total + MultipartForm._str_bytes("Content-Type: " + ctype + "\r\n\r\n");
            total = total + body.length;
            total = total + 2;
            i = i + 1;
        }
        total = total + MultipartForm._str_bytes("--" + boundary + "--\r\n");

        let body_buf = Buffer.alloc<byte>(total);
        let offset = 0;
        i = 0;
        while (i < this.field_names.length) {
            let name = this.field_names.get(i).unwrap_or("");
            let value = this.field_values.get(i).unwrap_or("");
            offset = MultipartForm._write_str(body_buf, offset, "--" + boundary + "\r\n");
            offset = MultipartForm._write_str(
                body_buf,
                offset,
                "Content-Disposition: form-data; name=\"" + name + "\"\r\n\r\n"
            );
            offset = MultipartForm._write_str(body_buf, offset, value);
            offset = MultipartForm._write_str(body_buf, offset, "\r\n");
            i = i + 1;
        }
        i = 0;
        while (i < this.file_names.length) {
            let name = this.file_names.get(i).unwrap_or("");
            let filename = this.file_filenames.get(i).unwrap_or("");
            let ctype = this.file_types.get(i).unwrap_or("application/octet-stream");
            let file_body = this.file_bodies.get(i).unwrap_or(Buffer.alloc<byte>(0));
            offset = MultipartForm._write_str(body_buf, offset, "--" + boundary + "\r\n");
            offset = MultipartForm._write_str(
                body_buf,
                offset,
                "Content-Disposition: form-data; name=\"" + name + "\"; filename=\"" + filename + "\"\r\n"
            );
            offset = MultipartForm._write_str(body_buf, offset, "Content-Type: " + ctype + "\r\n\r\n");
            offset = MultipartForm._write_bytes(body_buf, offset, file_body);
            offset = MultipartForm._write_str(body_buf, offset, "\r\n");
            i = i + 1;
        }
        MultipartForm._write_str(body_buf, offset, "--" + boundary + "--\r\n");

        let headers = HttpHeaders();
        headers.set("Content-Type", "multipart/form-data; boundary=" + boundary);
        return MultipartBuilt(headers, body_buf);
    }

    static fun _str_bytes(text: string): int {
        return text.length;
    }

    static fun _write_str(dst: byte[], offset: int, text: string): int {
        return MultipartForm._write_bytes(dst, offset, Bytes.fromWireString(text));
    }

    static fun _write_bytes(dst: byte[], offset: int, extra: byte[]): int {
        let src = Span<byte>.of(extra);
        let i = 0;
        while (i < src.length) {
            dst[offset + i] = src.get(i);
            i = i + 1;
        }
        return offset + src.length;
    }
}

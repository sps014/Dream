module system.io;

// FileStream - a seekable cursor over an open `FileHandle` (no whole-file preload).
public class FileStream {
    handle: FileHandle;
    pos: int;

    public constructor(handle: FileHandle) {
        this.handle = handle;
        this.pos = 0;
    }

    // Reads up to `n` raw bytes from the current position, advancing the cursor.
    public fun read_bytes(n: int): byte[] {
        let bytes = this.handle.read(n).unwrap_or(Buffer.alloc<byte>(0));
        this.pos = this.pos + bytes.length;
        return bytes;
    }

    // Reads up to `n` bytes from the current position as text, advancing the cursor.
    public fun read(n: int): string {
        let bytes = this.read_bytes(n);
        let count = bytes.length;
        let out = string.alloc(count);
        let i = 0;
        while (i < count) {
            string.set(out, i, (char)bytes[i]);
            i = i + 1;
        }
        return out;
    }

    // Reads everything remaining from the current position as text.
    public fun read_all(): string {
        let sz = File.size(this.handle.path);
        if (sz.is_none()) {
            return "";
        }
        let remaining = (int)sz.unwrap_or(0L) - this.pos;
        if (remaining < 0) {
            remaining = 0;
        }
        return this.read(remaining);
    }

    // True while the cursor has not reached the end of the file.
    public fun has_more(): bool {
        let sz = File.size(this.handle.path);
        if (sz.is_none()) {
            return false;
        }
        return this.pos < (int)sz.unwrap_or(0L);
    }

    // Current cursor offset (bytes from the start).
    public fun position(): int {
        return this.pos;
    }

    // Total file size in bytes (`-1` when the path is missing).
    public get length(): int {
        let sz = File.size(this.handle.path);
        if (sz.is_none()) {
            return (0 - 1);
        }
        return (int)sz.unwrap_or(0L);
    }

    // Moves the cursor to an absolute offset from the start of the file.
    public fun seek(offset: int): void {
        this.handle.seek((long)offset);
        this.pos = offset;
    }

    // Rewinds the cursor to the start.
    public fun reset(): void {
        this.seek(0);
    }

    // Releases the underlying OS handle.
    public fun close(): void {
        this.handle.close();
    }
}

module system.io;

// `File` - a small cross-runtime filesystem API.

public class File {
    // --- host bridge: synchronous externs (real WASM imports; no @intrinsic) -------------------
    @js("Dream", "fileRead")
    static extern fun file_read(path: string): string;

    // Overwrites `path` with `content`; returns the number of bytes written (-1 on error).
    @js("Dream", "fileWrite")
    static extern fun file_write(path: string, content: string): long;

    // Appends `content` to `path`; returns the number of bytes written (-1 on error).
    @js("Dream", "fileAppend")
    static extern fun file_append(path: string, content: string): long;

    // Binary I/O: bytes are bulk-copied straight between the file and a Dream `byte[]`, with no
    // string round-trip (binary-safe, minimal marshalling).
    @js("Dream", "fileReadBytes")
    static extern fun file_read_bytes(path: string): byte[];

    @js("Dream", "fileWriteBytes")
    static extern fun file_write_bytes(path: string, data: byte[]): long;

    @js("Dream", "fileExists")
    static extern fun file_exists(path: string): bool;

    // Deletes `path`; returns true on success.
    @js("Dream", "fileDelete")
    static extern fun file_delete(path: string): bool;

    // Size of `path` in bytes (-1 if it does not exist).
    @js("Dream", "fileSize")
    static extern fun file_size(path: string): long;

    @js("Dream", "fileIsDir")
    static extern fun file_is_dir(path: string): bool;

    // Directory entries joined by '\n' ("" when empty or not a directory); split into string[] below.
    @js("Dream", "dirList")
    static extern fun dir_list(path: string): string;

    @js("Dream", "dirCreate")
    static extern fun dir_create(path: string): bool;

    @js("Dream", "dirCreateAll")
    static extern fun dir_create_all(path: string): bool;

    // Reads the whole file at `path` as UTF-8 text.
    public static async fun read(path: string): Result<string, IoError> {
        if (File.exists(path) == false) {
            return Result.Err(IoError.not_found(path));
        }
        return Result.Ok(File.file_read(path));
    }

    // Overwrites `path` with `content`; resolves with `Ok(bytes_written)` or `Err` on failure.
    public static async fun write(path: string, content: string): Result<long, IoError> {
        let n = File.file_write(path, content);
        if (n < 0L) {
            return Result.Err(IoError.other(path, "failed to write file: " + path));
        }
        return Result.Ok(n);
    }

    // Appends `content` to the end of `path`; resolves with `Ok(bytes_written)` or `Err`.
    public static async fun append(path: string, content: string): Result<long, IoError> {
        let n = File.file_append(path, content);
        if (n < 0L) {
            return Result.Err(IoError.other(path, "failed to append to file: " + path));
        }
        return Result.Ok(n);
    }

    // Reads the whole file at `path` as raw bytes.
    public static async fun read_bytes(path: string): Result<byte[], IoError> {
        if (File.exists(path) == false) {
            return Result.Err(IoError.not_found(path));
        }
        return Result.Ok(File.file_read_bytes(path));
    }

    // Writes raw bytes to `path`, replacing any existing contents.
    public static async fun write_bytes(path: string, data: byte[]): Result<long, IoError> {
        let n = File.file_write_bytes(path, data);
        if (n < 0L) {
            return Result.Err(IoError.other(path, "failed to write file: " + path));
        }
        return Result.Ok(n);
    }

    // Deletes `path`; resolves `Ok(true)` on success.
    public static async fun delete(path: string): Result<bool, IoError> {
        if (File.file_delete(path) == false) {
            if (File.exists(path) == false) {
                return Result.Err(IoError.not_found(path));
            }
            return Result.Err(IoError.other(path, "failed to delete: " + path));
        }
        return Result.Ok(true);
    }

    // Creates a single directory at `path`; resolves `Ok(true)` on success.
    public static async fun create_dir(path: string): Result<bool, IoError> {
        if (File.dir_create(path) == false) {
            if (File.exists(path)) {
                return Result.Err(IoError.exists(path));
            }
            return Result.Err(IoError.other(path, "failed to create directory: " + path));
        }
        return Result.Ok(true);
    }

    // Creates `path` and any missing parents; resolves `Ok(true)` on success.
    public static async fun create_dir_all(path: string): Result<bool, IoError> {
        if (File.dir_create_all(path) == false) {
            return Result.Err(IoError.other(path, "failed to create directories: " + path));
        }
        return Result.Ok(true);
    }

    // Lists the entries of directory `path`. An empty or non-directory path yields an empty array.
    public static async fun list(path: string): string[] {
        let joined = File.dir_list(path);
        if (joined.is_empty()) {
            return Buffer.alloc<string>(0);
        }
        return joined.split('\n');
    }

    // Cheap synchronous predicates (no async overhead).
    public static fun exists(path: string): bool {
        return File.file_exists(path);
    }
    // Size of `path` in bytes, or `None` if it does not exist.
    public static fun size(path: string): Option<long> {
        let s = File.file_size(path);
        if (s < 0L) {
            return Option.None;
        }
        return Option.Some(s);
    }
    public static fun is_dir(path: string): bool {
        return File.file_is_dir(path);
    }

    // Opens a seekable read stream over `path` (OS-backed; no whole-file preload).
    public static fun open(path: string): Result<FileStream, IoError> {
        return switch (FileHandle.open(path, "r")) {
            Ok(h) => Result.Ok(FileStream(h)),
            Err(e) => Result.Err(e),
        };
    }

    // Async wrapper around `open`.
    public static async fun open_async(path: string): Result<FileStream, IoError> {
        return File.open(path);
    }
}

module system.collections;

// Cursor produced by `List.iterator()`.
public class ListIterator<T> : Iterator<T> {
    list: List<T>;
    idx: int;

    // Starts at the beginning of `list`.
    public constructor(list: List<T>) {
        this.list = list;
        this.idx = 0;
    }

    // Returns the next element, or `None` if exhausted.
    @next
    public fun next(): Option<T> {
        if (this.idx >= this.list.length) {
            return Option.None;
        }
        let value = this.list.get(this.idx);
        this.idx = this.idx + 1;
        return value;
    }
}

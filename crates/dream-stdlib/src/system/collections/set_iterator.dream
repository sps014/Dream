module system.collections;

// An iterator for traversing a `Set` — walks occupied slots in place (no snapshot).
public class SetIterator<T> : Iterator<T> {
    set: Set<T>;
    index: int;

    // Starts at slot 0 of `set`.
    public constructor(set: Set<T>) {
        this.set = set;
        this.index = 0;
    }

    // Returns the next element, or `None` if exhausted.
    @next
    public fun next(): Option<T> {
        while (this.index < this.set.capacity()) {
            let i = this.index;
            this.index = this.index + 1;
            if (this.set.slot_occupied(i)) {
                return Option.Some(this.set.slot_key(i));
            }
        }
        return Option.None;
    }
}

module system.collections;

// Cursor produced by `Map.iterator()` — walks occupied slots in place (no snapshot).
public class MapIterator<K, V> : Iterator<KeyValuePair<K, V>> {
    map: Map<K, V>;
    idx: int;

    // Starts at slot 0 of `map`.
    public constructor(map: Map<K, V>) {
        this.map = map;
        this.idx = 0;
    }

    // Returns the next key/value pair, or `None` if exhausted.
    @next
    public fun next(): Option<KeyValuePair<K, V>> {
        while (this.idx < this.map.capacity()) {
            let i = this.idx;
            this.idx = this.idx + 1;
            if (this.map.slot_occupied(i)) {
                return Option.Some(KeyValuePair<K, V>(this.map.slot_key(i), this.map.slot_value(i)));
            }
        }
        return Option.None;
    }
}

module system.collections;

// Package query helpers on `Collection<T>`: available after `import system.collections;`.
// Attached via `extend Collection<T>` so bootstrap `system.core` never depends on `List`/`Set`.

extend Collection<T> {
    // Copies every element into a new `List`.
    public fun to_list(): List<T> {
        let result = List<T>();
        for (let x in this) {
            result.push(x);
        }
        return result;
    }

    // Keeps elements for which `pred` is true.
    public fun filter(pred: fun(T): bool): List<T> {
        let result = List<T>();
        for (let x in this) {
            if (pred(x)) {
                result.push(x);
            }
        }
        return result;
    }

    // Maps each element through `f`.
    public fun map<U>(f: fun(T): U): List<U> {
        let result = List<U>();
        for (let x in this) {
            result.push(f(x));
        }
        return result;
    }

    // Left-fold with seed `init`.
    public fun reduce<A>(init: A, f: fun(A, T): A): A {
        let acc = init;
        for (let x in this) {
            acc = f(acc, x);
        }
        return acc;
    }

    // Inserts every element into a new `Set` (deduplicating).
    public fun collect_set(): Set<T> {
        let result = Set<T>();
        for (let x in this) {
            result.add(x);
        }
        return result;
    }

    // Removes duplicates while preserving first-seen order.
    public fun distinct(): List<T> {
        let seen = Set<T>();
        let result = List<T>();
        for (let x in this) {
            if (!seen.contains(x)) {
                seen.add(x);
                result.push(x);
            }
        }
        return result;
    }

    // Maps each element to a list and concatenates the results.
    public fun flat_map<U>(f: fun(T): List<U>): List<U> {
        let result = List<U>();
        for (let x in this) {
            let inner = f(x);
            for (let y in inner) {
                result.push(y);
            }
        }
        return result;
    }

    // Keeps at most the first `n` elements.
    public fun take(n: int): List<T> {
        let result = List<T>();
        let i = 0;
        for (let x in this) {
            if (i >= n) {
                break;
            }
            result.push(x);
            i = i + 1;
        }
        return result;
    }

    // Drops the first `n` elements.
    public fun skip(n: int): List<T> {
        let result = List<T>();
        let i = 0;
        for (let x in this) {
            if (i >= n) {
                result.push(x);
            }
            i = i + 1;
        }
        return result;
    }

    // Copies into a list and sorts by `cmp`.
    public fun order_by(cmp: fun(T, T): int): List<T> {
        let result = this.to_list();
        result.sort_by(cmp);
        return result;
    }

    // Starts an eager `Seq` chain over a copy of the elements.
    public fun seq(): Seq<T> {
        let items = List<T>();
        for (let x in this) {
            items.push(x);
        }
        return Seq<T>(items);
    }
}

module system.gpu;

// Device lifecycle, host bridges, kernel barriers.

public class Gpu {
    @js("Dream", "gpuIsAvailable")
    static extern fun is_available_host(): bool;

    @js("Dream", "gpuTryInit")
    static extern async fun try_init_host(): int;

    @js("Dream", "gpuReady")
    static extern fun ready_host(): bool;

    @js("Dream", "gpuFrame")
    static extern async fun frame_host(): void;

    @js("Dream", "gpuTimestamp")
    static extern async fun timestamp_host(): long;

    // True when a WebGPU/native GPU backend is present.
    public static fun is_available(): bool {
        return Gpu.is_available_host();
    }

    // True after a successful `try_init`.
    public static fun ready(): bool {
        return Gpu.ready_host();
    }

    // Initializes the GPU device; returns `Err` with a host error code on failure.
    public static async fun try_init(): Result<bool, GpuError> {
        let code = await Gpu.try_init_host();
        if (code == 0) { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "Gpu.try_init failed"));
    }

    // Yields until the next presentation/frame tick.
    public static async fun frame(): void {
        await Gpu.frame_host();
    }

    // High-resolution GPU timestamp in nanoseconds (host-defined epoch).
    public static async fun timestamp(): long {
        return await Gpu.timestamp_host();
    }

    @js("Dream", "gpuBufferAllocBytes")
    static extern fun buffer_alloc_bytes(n: int): int;

    @js("Dream", "gpuBufferWriteBytes")
    static extern fun buffer_write_bytes(id: int, data: byte[]): void;

    @js("Dream", "gpuBufferWriteBytesAt")
    static extern fun buffer_write_bytes_at(id: int, byte_offset: int, data: byte[]): void;

    @js("Dream", "gpuBufferReadBytes")
    static extern async fun buffer_read_bytes(id: int, n: int): byte[];

    @js("Dream", "gpuBufferReadBytesAt")
    static extern async fun buffer_read_bytes_at(id: int, byte_offset: int, n: int): byte[];

    @js("Dream", "gpuDispatch")
    static extern async fun dispatch(
        kernel: string,
        buffer_ids: int[],
        ex: int,
        ey: int,
        ez: int,
        uniforms: byte[]
    ): int;

    @js("Dream", "gpuShaderFromWgsl")
    static extern fun shader_from_wgsl(source: string, entry: string): int;

    @js("Dream", "gpuDispatchShader")
    static extern async fun dispatch_shader(
        shader_id: int,
        buffer_ids: int[],
        wx: int,
        wy: int,
        wz: int
    ): int;

    @js("Dream", "gpuTextureCreateRgba8")
    static extern fun texture_create_rgba8(width: int, height: int): int;

    @js("Dream", "gpuTextureWriteRgba")
    static extern async fun texture_write_rgba(
        id: int,
        pixels: byte[],
        x: int,
        y: int,
        w: int,
        h: int
    ): int;

    @js("Dream", "gpuTextureReadRgba")
    static extern async fun texture_read_rgba(id: int): byte[];

    @js("Dream", "gpuSurfaceFromCanvas")
    static extern fun surface_from_canvas(canvas_id: string): int;

    @js("Dream", "gpuSurfaceConfigure")
    static extern fun surface_configure(id: int, width: int, height: int): void;

    @js("Dream", "gpuSurfacePresent")
    static extern async fun surface_present(id: int): int;

    @js("Dream", "gpuRenderBlit")
    static extern async fun render_blit(surface_id: int, texture_id: int): int;

    // Workgroup barrier (no-op on CPU; WGSL emitter maps this inside `@compute`).
    public static fun workgroup_barrier(): void {}
    // Storage memory barrier (no-op on CPU; WGSL emitter maps this inside `@compute`).
    public static fun storage_barrier(): void {}
}

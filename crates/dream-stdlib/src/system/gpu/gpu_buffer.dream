module system.gpu;

// GPU storage buffer of blittable `T` elements (`T : unmanaged`).
// Value-typed handle (id / length / stride); device memory lives on the host/WebGPU side.
public struct GpuBuffer<T : unmanaged> {
    _id: int;
    _length: int;
    _stride: int;

    // Number of elements this buffer holds.
    public get length(): int {
        return this._length;
    }

    // Host-side buffer handle id.
    public get id(): int {
        return this._id;
    }

    // Byte size of one `T` element.
    public get stride(): int {
        return this._stride;
    }

    // Allocates an uninitialized GPU buffer of `n` elements.
    public static fun alloc(n: int): GpuBuffer<T> {
        let scratch = Buffer.alloc<T>(1);
        let stride = Bytes.of(scratch[0]).length;
        let b = GpuBuffer<T>();
        b._id = Gpu.buffer_alloc_bytes(n * stride);
        b._length = n;
        b._stride = stride;
        return b;
    }

    // Allocates a buffer and uploads `data`.
    public static fun from(data: T[]): GpuBuffer<T> {
        let b = GpuBuffer<T>.alloc(data.length);
        b.write(data);
        return b;
    }

    // Overwrites the whole buffer from CPU `data` (must match `length`).
    public fun write(data: T[]): void {
        let n = data.length;
        let out = Buffer.alloc<byte>(n * this._stride);
        for (let i = 0; i < n; i = i + 1) {
            let eb = Bytes.of(data[i]);
            for (let j = 0; j < this._stride; j = j + 1) {
                out[i * this._stride + j] = eb[j];
            }
        }
        Gpu.buffer_write_bytes(this._id, out);
    }

    // Partial CPU→GPU write starting at element `offset`.
    public fun write_at(offset: int, data: T[]): void {
        if (offset < 0 || data.length < 0) { return; }
        if (offset + data.length > this._length) {
            System.println("GpuBuffer.write_at: out of bounds");
            return;
        }
        let n = data.length;
        let out = Buffer.alloc<byte>(n * this._stride);
        for (let i = 0; i < n; i = i + 1) {
            let eb = Bytes.of(data[i]);
            for (let j = 0; j < this._stride; j = j + 1) {
                out[i * this._stride + j] = eb[j];
            }
        }
        Gpu.buffer_write_bytes_at(this._id, offset * this._stride, out);
    }

    // Reads the entire buffer back to a CPU array.
    public async fun read(): T[] {
        let bytes = await Gpu.buffer_read_bytes(this._id, this._length * this._stride);
        return GpuBuffer<T>.decode(bytes, this._length, this._stride);
    }

    // Reads `count` elements starting at element `offset`.
    public async fun read_at(offset: int, count: int): T[] {
        if (offset < 0 || count < 0 || offset + count > this._length) {
            return Buffer.alloc<T>(0);
        }
        let bytes = await Gpu.buffer_read_bytes_at(
            this._id,
            offset * this._stride,
            count * this._stride
        );
        return GpuBuffer<T>.decode(bytes, count, this._stride);
    }

    // GPU-side copy of `count` elements into `dst` (no CPU round-trip).
    public fun copy_to(dst: GpuBuffer<T>, src_offset: int, dst_offset: int, count: int): void {
        if (count <= 0) { return; }
        if (src_offset < 0 || dst_offset < 0) { return; }
        if (src_offset + count > this._length || dst_offset + count > dst._length) {
            System.println("GpuBuffer.copy_to: out of bounds");
            return;
        }
        if (this._stride != dst._stride) {
            System.println("GpuBuffer.copy_to: stride mismatch");
            return;
        }
        Gpu.buffer_copy(
            this._id,
            dst._id,
            src_offset * this._stride,
            dst_offset * this._stride,
            count * this._stride
        );
    }

    static fun decode(bytes: byte[], count: int, stride: int): T[] {
        let out = Buffer.alloc<T>(count);
        for (let i = 0; i < count; i = i + 1) {
            let slice = Buffer.alloc<byte>(stride);
            for (let j = 0; j < stride; j = j + 1) {
                slice[j] = bytes[i * stride + j];
            }
            out[i] = Bytes.to<T>(slice);
        }
        return out;
    }
}
